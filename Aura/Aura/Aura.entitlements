<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately the iOS bundle identifier, on BOTH targets. The default would be each
	     app's own identifier, which would give the Mac app a store of its own and defeat the
	     entire point: the phone and the Mac have to read and write the same one. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(AURA_BUNDLE_BASE)</string>
	<!-- Granted by Apple on 2026-09-28: the CarPlay audio app scene (CarPlaySceneDelegate). -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- Asking for music by name ("play Kygo on Aura") goes through SiriKit. -->
	<key>com.apple.developer.siri</key>
	<true/>
	<!-- Shared with the widget extension, which shows the song this writes. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(AURA_BUNDLE_BASE)</string>
	</array>
</dict>
</plist>
