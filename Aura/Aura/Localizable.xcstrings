    "Which mixes Home makes, from which genres, and how many songs each.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quels mix l'accueil crée, à partir de quels genres, et combien de morceaux chacun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quali mix crea la Home, da quali generi e quanti brani ciascuno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué mezclas crea Inicio, de qué géneros y cuántas canciones cada una."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Mixe die Startseite erstellt, aus welchen Genres und mit wie vielen Songs."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quines mescles fa l'Inici, de quins gèneres i quantes cançons cadascuna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke mixen Home maakt, uit welke genres en hoeveel nummers per mix."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首页生成哪些混音、来自哪些流派，以及每个混音的歌曲数。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какие миксы создаёт главная, из каких жанров и сколько песен в каждом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilka mixar Hem skapar, från vilka genrer och hur många låtar var och en har."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
