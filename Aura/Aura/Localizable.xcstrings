    "Drag to reorder. Switch a button off to hide it from Now Playing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réordonner. Désactivez un bouton pour le masquer de la lecture en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Disattiva un pulsante per nasconderlo da In riproduzione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Desactiva un botón para ocultarlo de Reproduciendo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen zum Sortieren. Schalte eine Taste aus, um sie unter „Wiedergabe“ auszublenden."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega per reordenar. Desactiva un botó per amagar-lo de Reproduint."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te ordenen. Zet een knop uit om hem te verbergen bij Wordt afgespeeld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。关闭某个按钮即可在正在播放中隐藏它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок. Выключите кнопку, чтобы скрыть её с экрана «Исполняется»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att ändra ordning. Stäng av en knapp för att dölja den från Spelas nu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta para reordenar. Desativa um botão para o ocultar de A reproduzir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Desative um botão para ocultá-lo em Tocando agora."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność. Wyłącz przycisk, aby ukryć go na ekranie Odtwarzane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。ボタンをオフにすると、再生中画面で非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 바꿔요. 버튼을 끄면 지금 재생 중 화면에서 숨겨져요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排列。關閉按鈕即可將其從「正在播放」中隱藏。"
          }
        }
      }
    }
  },
  "version": "1.1"
}
