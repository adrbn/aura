    "This colour is hard to see on Aura's dark background.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest color es veu malament sobre el fons fosc d'Aura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Farbe ist auf Auras dunklem Hintergrund schwer zu erkennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este color se ve mal sobre el fondo oscuro de Aura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette couleur se voit mal sur le fond sombre d’Aura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo colore si vede male sullo sfondo scuro di Aura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze kleur is moeilijk te zien op de donkere achtergrond van Aura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这种颜色在 Aura 的深色背景上不易看清。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот цвет плохо виден на темном фоне Aura."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här färgen syns dåligt mot Auras mörka bakgrund."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cor é difícil de ver no fundo escuro do Aura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cor é difícil de ver no fundo escuro do Aura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kolor jest słabo widoczny na ciemnym tle Aura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この色はAuraのダークな背景では見えにくいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 색상은 Aura의 어두운 배경에서 잘 보이지 않아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個顏色在 Aura 的深色背景上很難看清楚。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto barvu je na tmavém pozadí Aura špatně vidět."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne fargen er vanskelig å se på Auras mørke bakgrunn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne farve er svær at se på Auras mørke baggrund."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä väriä on vaikea erottaa Auran tummalla taustalla."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această culoare se vede greu pe fundalul întunecat al Aura."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей колір погано видно на темному тлі Aura."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu renk Aura'nın koyu arka planında zor görünür."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το χρώμα δύσκολα φαίνεται στο σκούρο φόντο του Aura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีนี้มองเห็นยากบนพื้นหลังสีเข้มของ Aura"
          }
        }
      }
    },
