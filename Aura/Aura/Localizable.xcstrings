    "Download songs while you're online, and they'll be here.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa cançons quan estiguis en línia i apareixeran aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Titel herunter, während du online bist — sie erscheinen dann hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga canciones cuando tengas conexión y aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez des titres quand vous êtes en ligne : ils apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica brani mentre sei online: appariranno qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download nummers terwijl je online bent, dan verschijnen ze hier."
          }
        }
      }
    },
    "Download songs, albums or playlists while you're online, and they'll be here.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa cançons, àlbums o playlists quan estiguis en línia i apareixeran aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Titel, Alben oder Playlists herunter, während du online bist — sie erscheinen dann hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga canciones, álbumes o listas cuando tengas conexión y aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez des titres, albums ou playlists quand vous êtes en ligne : ils apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica brani, album o playlist mentre sei online: appariranno qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download nummers, albums of playlists terwijl je online bent, dan verschijnen ze hier."
          }
        }
      }
    },
    "Downloaded, but your server hasn't added it yet": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixada, però el servidor encara no l'ha afegit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladen, aber dein Server hat es noch nicht hinzugefügt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargada, pero tu servidor aún no la ha añadido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargé, mais pas encore ajouté par le serveur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaricato, ma non ancora aggiunto dal server"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedownload, maar nog niet toegevoegd door je server"
          }
        }
      }
    },
    "Downloads stay until you remove them. Streamed songs are kept too, but iOS may clear them when storage runs low.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les baixades es queden fins que les suprimeixis. Les cançons escoltades en streaming també es guarden, però iOS les pot esborrar si l'espai s'esgota."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads bleiben, bis du sie entfernst. Gestreamte Titel werden ebenfalls behalten, aber iOS kann sie bei knappem Speicher löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas permanecen hasta que las quites. Las canciones reproducidas en streaming también se guardan, pero iOS puede borrarlas si falta espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements restent jusqu’à leur suppression. Les titres écoutés en streaming sont aussi gardés, mais iOS peut les effacer si le stockage manque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download restano finché non li rimuovi. Anche i brani riprodotti in streaming vengono conservati, ma iOS potrebbe eliminarli se lo spazio di archiviazione scarseggia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads blijven staan tot je ze verwijdert. Gestreamde nummers worden ook bewaard, maar iOS kan ze wissen als de opslag bijna vol is."
          }
        }
      }
    },
