            "value": "«%@» ja existeix. Vols veure-la o generar-ne una de nova?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ existiert bereits. Ansehen oder eine neue erstellen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya existe. ¿Quieres verla o generar una nueva?"
          }
        },
        "fr": {
          "stringUnit": {
