          "stringUnit": {
            "state": "translated",
            "value": "Letras brancas ficam difíceis de ler nesta cor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Białe etykiety są słabo czytelne na tym kolorze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白いラベルはこの色では読みにくくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 색상에서는 흰색 레이블이 읽기 어려워요."
