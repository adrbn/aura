    "Aura is a native SwiftUI client for the Navidrome or Subsonic library you host yourself. No ads, no tracking, no cloud in between.": {
      "comment": "A description of the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura és un client SwiftUI natiu per a la biblioteca Navidrome o Subsonic que allotges tu mateix. Sense anuncis, sense seguiment, sense núvol pel mig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura ist ein nativer SwiftUI-Client für die Navidrome- oder Subsonic-Bibliothek, die du selbst hostest. Keine Werbung, kein Tracking, keine Cloud dazwischen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura es un cliente nativo en SwiftUI para la biblioteca Navidrome o Subsonic que alojas tú mismo. Sin anuncios, sin seguimiento, sin nube de por medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura est un client SwiftUI natif pour la bibliothèque Navidrome ou Subsonic que vous hébergez. Pas de pub, pas de pistage, aucun cloud entre les deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura è un client SwiftUI nativo per la libreria Navidrome o Subsonic che ospiti tu stesso. Niente pubblicità, niente tracciamento, nessun cloud di mezzo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura is een native SwiftUI-app voor de Navidrome- of Subsonic-bibliotheek die je zelf host. Geen advertenties, geen tracking, geen cloud ertussen."
          }
        }
      }
    },
