    },
    "Gemini reads the whole song before translating it, so the meaning comes through: idioms, double negatives, slang and creoles. Each translation sits under its sung line.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini llegeix tota la cançó abans de traduir-la, perquè es noti el significat: expressions fetes, dobles negacions, argot i crioll. Cada traducció apareix sota la línia cantada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini liest den gesamten Songtext, bevor er übersetzt wird, damit der Sinn erhalten bleibt: Redewendungen, doppelte Verneinungen, Slang und Kreolsprachen. Jede Übersetzung steht unter der gesungenen Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini lee la canción entera antes de traducirla, para que se entienda el sentido: modismos, dobles negaciones, jerga y criollos. Cada traducción aparece bajo su línea cantada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini lit toute la chanson avant de la traduire, pour en rendre le sens : expressions, doubles négations, argot et créoles. Chaque traduction s’affiche sous la ligne chantée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini legge l'intero brano prima di tradurlo, per renderne il senso: modi di dire, doppie negazioni, slang e creoli. Ogni traduzione compare sotto la riga cantata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini leest het hele nummer voordat het vertaalt, zodat de betekenis behouden blijft: uitdrukkingen, dubbele ontkenningen, straattaal en creooltalen. Elke vertaling verschijnt onder de gezongen regel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini 会先读完整首歌再翻译，让意思准确传达：习语、双重否定、俚语和克里奥尔语都不在话下。每句翻译显示在对应的演唱歌词下方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini читает всю песню перед переводом, поэтому смысл сохраняется: идиомы, двойные отрицания, сленг и креольские языки. Каждый перевод стоит под своей строкой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini läser hela låten innan den översätter, så att betydelsen kommer fram: idiom, dubbla negationer, slang och kreolspråk. Varje översättning står under sin sjungna rad."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gemini lê a música inteira antes de a traduzir, para que o sentido passe: expressões idiomáticas, dupla negação, gíria e crioulos. Cada tradução fica por baixo do verso cantado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gemini lê a música inteira antes de traduzir, então o sentido se mantém: expressões idiomáticas, dupla negação, gírias e crioulos. Cada tradução fica sob o verso cantado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini czyta cały utwór przed tłumaczeniem, dzięki czemu sens zostaje zachowany: idiomy, podwójne przeczenia, slang i kreole. Każde tłumaczenie znajduje się pod śpiewanym wersem."
          }
        }
      }
    },
