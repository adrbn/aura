          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do Google trafiają tylko teksty, które tłumaczysz, wraz z tytułem i wykonawcą utworu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleに送信されるのは、翻訳する歌詞と、曲のタイトルおよびアーティスト名のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역하는 가사만 곡 제목 및 아티스트와 함께 Google로 전송돼요."
          }
        },
        "zh-Hant": {
