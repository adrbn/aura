    "Your Mac's language. Songs already in it aren't translated.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'idioma del teu Mac. Les cançons que ja hi són no es tradueixen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache deines Macs. Titel, die bereits in dieser Sprache sind, werden nicht übersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de tu Mac. Las canciones que ya están en ese idioma no se traducen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue de votre Mac. Les chansons déjà dans cette langue ne sont pas traduites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua del tuo Mac. I brani già in questa lingua non vengono tradotti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taal van je Mac. Nummers die daar al in staan, worden niet vertaald."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык вашего Mac. Песни, уже написанные на нем, не переводятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 语言。已是该语言的歌曲不会被翻译。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Macs språk. Låtar som redan är på det översätts inte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma do teu Mac. As músicas que já estão nesse idioma não são traduzidas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma do seu Mac. Músicas que já estão nele não são traduzidas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Język Twojego Maca. Utwory, które już w nim są, nie są tłumaczone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの言語です。すでにその言語の曲は翻訳されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 Mac의 언어예요. 이미 해당 언어인 곡은 번역하지 않아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你 Mac 的語言。已是該語言的歌曲不會翻譯。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk tvého Macu. Skladby, které už v něm jsou, se nepřekládají."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Språket på Macen din. Sanger som allerede er på det, oversettes ikke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Macs sprog. Sange, der allerede er på det sprog, oversættes ikke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Macisi kieli. Jo sillä kielellä olevia kappaleita ei käännetä."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limba Mac-ului tău. Melodiile deja în această limbă nu sunt traduse."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мова вашого Mac. Пісні, вже написані нею, не перекладаються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inin dili. Zaten bu dilde olan şarkılar çevrilmez."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γλώσσα του Mac σου. Τα τραγούδια που είναι ήδη σε αυτήν δεν μεταφράζονται."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาษาของ Mac ของคุณ เพลงที่เป็นภาษานี้อยู่แล้วจะไม่ถูกแปล"
          }
        }
      }
    },
    "A song translated once is kept on this Mac, and comes back offline.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cançó traduïda una vegada es queda en aquest Mac i torna a aparèixer sense connexió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einmal übersetzter Songtext bleibt auf diesem Mac gespeichert und ist auch offline verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una canción traducida una vez se guarda en este Mac, y vuelve a aparecer sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chanson traduite une fois reste sur ce Mac, même hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brano tradotto una volta resta su questo Mac, anche offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nummer dat eenmaal vertaald is, blijft op deze Mac staan en werkt ook offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Однажды переведенная песня сохраняется на этом Mac и доступна офлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲翻译一次后会保留在这台 Mac 上，离线时也能显示。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En låt som översatts en gång sparas på den här Macen och finns kvar offline."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma música traduzida uma vez fica guardada neste Mac e volta a estar disponível sem ligação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma música traduzida uma vez fica salva neste Mac e volta mesmo offline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz przetłumaczony utwór jest zapisywany na tym Macu i wraca także offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度翻訳した曲はこのMacに保存され、オフラインでも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 번역한 곡은 이 Mac에 저장되어 오프라인에서도 볼 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯過一次的歌曲會保留在這部 Mac 上，離線時也能使用。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednou přeložená skladba se uloží do tohoto Macu a funguje i offline."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En sang som er oversatt én gang, beholdes på denne Macen og er tilgjengelig offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En sang, der er oversat én gang, gemmes på denne Mac og er også tilgængelig offline."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerran käännetty kappale säilyy tässä Macissa ja on käytettävissä myös offline-tilassa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O melodie tradusă o dată rămâne pe acest Mac și revine și offline."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекладена пісня зберігається на цьому Mac і доступна офлайн."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez çevrilen şarkı bu Mac'te saklanır ve çevrimdışıyken de gelir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα τραγούδι που μεταφράστηκε μία φορά μένει σε αυτό το Mac και επανέρχεται εκτός σύνδεσης."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงที่แปลแล้วครั้งหนึ่งจะเก็บไว้ใน Mac เครื่องนี้ และกลับมาได้แม้ออฟไลน์"
          }
        }
      }
    },
    "The key stays in this Mac's Keychain.": {
      "localizations": {
