    "Your entire library at your fingertips.\nLossless or transcoded, your choice.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tota la teva biblioteca a l'abast de la mà.\nSense pèrdua o transcodificada, tu tries."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gesamte Bibliothek immer griffbereit.\nVerlustfrei oder umgewandelt, du entscheidest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda tu biblioteca al alcance de tu mano.\nSin pérdida o transcodificada, tú eliges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute votre bibliothèque à portée de main.\nSans perte ou transcodé, à vous de choisir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta la tua libreria a portata di mano.\nSenza perdita di qualità o transcodificata, a tua scelta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hele bibliotheek binnen handbereik.\nLossless of getranscodeerd, jij kiest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个资料库触手可及。\n无损或转码，由你选择。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся медиатека у вас под рукой.\nБез потерь или с перекодированием — на ваш выбор."
          }
        }
      }
    },
