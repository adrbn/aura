        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลลัพธ์ออฟไลน์ — เฉพาะเพลงที่ดาวน์โหลดและแคชไว้"
          }
        }
      }
    },
    "Once Last.fm has scrobbles in this period, your top songs, artists, and genres show up here.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan Last.fm tingui scrobbles en aquest període, les teves cançons, artistes i gèneres més escoltats apareixeran aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Last.fm Scrobbles für diesen Zeitraum hat, erscheinen hier deine meistgehörten Titel, Interpreten und Genres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cuanto Last.fm tenga scrobbles en este período, tus canciones, artistas y géneros más escuchados aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que Last.fm aura des scrobbles sur cette période, vos titres, artistes et genres les plus écoutés s'afficheront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non appena Last.fm avrà scrobble in questo periodo, i tuoi brani, artisti e generi più ascoltati appariranno qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra Last.fm scrobbles heeft voor deze periode, verschijnen hier je populairste nummers, artiesten en genres."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Last.fm 在此期间有了 Scrobble 记录，你最常听的歌曲、艺人和风格就会显示在这里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда в Last.fm появятся скробблы за этот период, здесь будут ваши любимые песни, артисты и жанры."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När Last.fm har scrobblar för den här perioden visas dina mest spelade låtar, artister och genrer här."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o Last.fm tiver scrobbles neste período, as tuas músicas, artistas e géneros mais ouvidos aparecem aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o Last.fm tiver scrobbles neste período, suas músicas, artistas e gêneros mais ouvidos aparecerão aqui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy Last.fm zapisze scrobble z tego okresu, pojawią się tutaj Twoje najczęściej słuchane utwory, wykonawcy i gatunki."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間にLast.fmのスクロブルが記録されると、トップソング、アーティスト、ジャンルがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간에 Last.fm 스크로블이 생기면 인기 곡, 아티스트, 장르가 여기에 표시돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 在此期間有 scrobble 後，你的熱門歌曲、演出者和曲風就會顯示在這裡。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile Last.fm zaznamená scrobbly z tohoto období, objeví se tu tvé nejposlouchanější skladby, interpreti a žánry."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når Last.fm har scrobbles i denne perioden, vises toppsangene, -artistene og -sjangrene dine her."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når Last.fm har scrobbles i denne periode, vises dine topsange, -kunstnere og -genrer her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun Last.fm:ssä on scrobbleja tältä ajalta, suosituimmat kappaleesi, artistisi ja tyylilajisi näkyvät täällä."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când Last.fm va avea scrobble-uri în această perioadă, melodiile, artiștii și genurile tale de top vor apărea aici."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли в Last.fm з’являться скроблі за цей період, тут будуть ваші найкращі пісні, виконавці й жанри."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm'de bu dönem için scrobble olduğunda en çok dinlediğin şarkılar, sanatçılar ve türler burada görünür."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόλις το Last.fm έχει scrobbles σε αυτή την περίοδο, τα κορυφαία τραγούδια, οι καλλιτέχνες και τα είδη σου εμφανίζονται εδώ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อ Last.fm มี scrobble ในช่วงนี้ เพลง ศิลปิน และแนวเพลงยอดนิยมของคุณจะแสดงที่นี่"
          }
        }
      }
    },
