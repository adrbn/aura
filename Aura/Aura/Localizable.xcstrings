    "Optional. Sent with every request to this server, for a reverse proxy or a sign-in gateway in front of it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Envoyés avec chaque requête vers ce serveur, pour un reverse proxy ou une passerelle de connexion placée devant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltative. Inviate con ogni richiesta a questo server, per un reverse proxy o un gateway di accesso davanti a esso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Se envían con cada petición a este servidor, para un proxy inverso o una pasarela de acceso delante de él."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Werden mit jeder Anfrage an diesen Server gesendet, für einen Reverse Proxy oder ein Anmelde-Gateway davor."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. S'envien amb cada petició a aquest servidor, per a un proxy invers o una passarel·la d'accés al davant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Meegestuurd met elk verzoek aan deze server, voor een reverse proxy of een inloggateway ervoor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。随每个发往此服务器的请求一起发送，适用于其前面的反向代理或登录网关。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Отправляются с каждым запросом к этому серверу — для обратного прокси или шлюза входа перед ним."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt. Skickas med varje begäran till den här servern, för en omvänd proxy eller en inloggningsgateway framför den."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Enviados com cada pedido a este servidor, para um proxy inverso ou um portal de início de sessão colocado à frente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Enviados em toda solicitação a este servidor, para um proxy reverso ou um gateway de login na frente dele."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie. Wysyłane z każdym żądaniem do tego serwera, dla reverse proxy lub bramki logowania przed nim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。リバースプロキシやサインインゲートウェイがサーバの前にある場合に、このサーバへのすべてのリクエストと一緒に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 이 서버 앞의 리버스 프록시나 로그인 게이트웨이를 위해 모든 요청과 함께 전송돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選填。會隨每個傳送到這個伺服器的要求一併傳送，適用於其前方的反向代理伺服器或登入閘道。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné. Odesílá se s každým požadavkem na tento server, pro reverzní proxy nebo přihlašovací bránu před ním."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. Sendes med hver forespørsel til denne serveren, for en omvendt proxy eller en påloggingsportal foran den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit. Sendes med hver anmodning til denne server, til en reverse proxy eller en login-gateway foran den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen. Lähetetään jokaisen tälle palvelimelle menevän pyynnön mukana käänteistä välityspalvelinta tai sen edessä olevaa kirjautumisyhdyskäytävää varten."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional. Trimise cu fiecare cerere către acest server, pentru un reverse proxy sau un gateway de autentificare din fața lui."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язково. Надсилаються з кожним запитом до цього сервера — для зворотного проксі чи шлюзу входу перед ним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Bu sunucuya yapılan her istekle gönderilir; önündeki bir ters proxy veya giriş ağ geçidi için."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικό. Αποστέλλονται με κάθε αίτημα σε αυτόν τον διακομιστή, για reverse proxy ή πύλη σύνδεσης μπροστά του."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ ส่งไปพร้อมทุกคำขอไปยังเซิร์ฟเวอร์นี้ สำหรับ reverse proxy หรือเกตเวย์ลงชื่อเข้าที่อยู่ด้านหน้า"
          }
        }
      }
    },
    "Aura can’t listen to songs in this language yet.": {
      "localizations": {
        "fr": {
