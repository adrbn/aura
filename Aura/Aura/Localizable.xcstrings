    "Positive shows the words earlier. Bluetooth headphones usually need a nudge.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor positiu mostra les paraules abans. Els auriculars Bluetooth solen necessitar un petit ajust."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein positiver Wert zeigt die Wörter früher an. Bluetooth-Kopfhörer brauchen meist einen kleinen Versatz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor positivo adelanta las palabras. Los auriculares Bluetooth suelen necesitar un pequeño ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une valeur positive affiche les mots plus tôt. Les écouteurs Bluetooth demandent souvent un petit décalage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valore positivo mostra le parole prima. Le cuffie Bluetooth di solito richiedono un piccolo scarto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een positieve waarde toont de woorden eerder. Bluetooth-koptelefoons hebben vaak een kleine correctie nodig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值会让歌词更早显示。蓝牙耳机通常需要稍作调整。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положительное значение показывает слова раньше. Bluetooth-наушникам обычно нужна небольшая поправка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett positivt värde visar orden tidigare. Bluetooth-hörlurar behöver oftast en justering."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um valor positivo mostra as palavras mais cedo. Os auscultadores Bluetooth costumam precisar de um pequeno ajuste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor positivo mostra as palavras mais cedo. Fones Bluetooth costumam precisar de um empurrãozinho."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartość dodatnia pokazuje słowa wcześniej. Słuchawki Bluetooth zwykle wymagają korekty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラスにすると歌詞が早く表示されます。Bluetoothヘッドフォンでは通常、調整が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양수로 하면 가사가 더 일찍 표시돼요. Bluetooth 헤드폰은 보통 조금 조정해야 해요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正值會讓歌詞提早顯示。藍牙耳機通常需要稍微調整。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kladná hodnota zobrazí slova dříve. Sluchátka Bluetooth obvykle potřebují doladit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Positiv verdi viser ordene tidligere. Bluetooth-hodetelefoner trenger som regel en liten justering."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Positiv viser ordene tidligere. Bluetooth-hovedtelefoner skal som regel justeres en smule."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Positiivinen arvo näyttää sanat aiemmin. Bluetooth-kuulokkeet tarvitsevat yleensä pienen säädön."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O valoare pozitivă afișează cuvintele mai devreme. Căștile Bluetooth au de obicei nevoie de o mică ajustare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додатне значення показує слова раніше. Навушникам Bluetooth зазвичай потрібна невелика поправка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozitif değer sözleri daha erken gösterir. Bluetooth kulaklıklar genelde biraz ayar ister."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι θετικές τιμές δείχνουν τους στίχους νωρίτερα. Τα ακουστικά Bluetooth συνήθως θέλουν μια μικρή διόρθωση."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าบวกจะแสดงคำร้องเร็วขึ้น หูฟัง Bluetooth มักต้องขยับเล็กน้อย"
          }
        }
      }
    },
