        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic na tomto iPhonu neodpovídá „%@“."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting på denne iPhonen samsvarer med «%@»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet på denne iPhone matcher “%@”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään tässä iPhonessa ei vastaa hakua ”%@”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic de pe acest iPhone nu corespunde cu „%@”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому iPhone ніщо не відповідає «%@»."
