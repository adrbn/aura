    "Cycles repeat in Aura: off, all, then one.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvia el mode de repetició de l'Aura: desactivada, tot, i després una cançó."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Wiederholung in Aura durch: aus, alle, dann einen Titel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el modo de repetición en Aura: desactivada, todo, luego una canción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait tourner la répétition dans Aura : désactivée, tout, puis un titre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa scorrere la ripetizione in Aura: disattivata, tutti, poi un brano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorloopt herhalen in Aura: uit, alles, dan één."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Aura 中循环切换重复模式：关闭、全部、单曲。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключает повтор в Aura: выкл., все, затем одна песня."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växlar upprepning i Aura: av, alla, sedan en."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna a repetição no Aura: desativada, tudo e uma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna a repetição no Aura: desativada, todas e uma."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącza powtarzanie w Aura: wyłączone, wszystko, jeden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Auraのリピートを切り替えます。オフ、すべて、1曲の順です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura에서 반복 모드를 순환해요: 끔, 전체, 한 곡."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "循環切換 Aura 中的重複模式：關閉、全部、單曲。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepíná opakování v Aura: vypnuto, vše, jedna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Veksler gjentakelse i Aura: av, alle og deretter én."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skifter gentagelse i Aura: fra, alle, derefter én."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihtaa toistotilaa Aurassa: pois, kaikki, yksi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comută repetarea în Aura: dezactivată, toate, apoi una."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикає повтор в Aura: вимк., усі, потім один."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura'da tekrarlama modları arasında geçer: kapalı, tümü, sonra bir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζει την επανάληψη στο Aura: ανενεργή, όλα, μετά ένα."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วนการเล่นซ้ำใน Aura: ปิด ทั้งหมด แล้วหนึ่งเพลง"
          }
        }
      }
    },
