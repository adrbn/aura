    "Time-synced lyrics scroll in real time.\nTap any line to jump to that moment.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La lletra sincronitzada es desplaça en temps real.\nToca una línia per saltar a aquest moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitsynchronisierter Songtext läuft in Echtzeit mit.\nTippe auf eine Zeile, um zu diesem Moment zu springen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La letra avanza en tiempo real, sincronizada.\nToca cualquier línea para saltar a ese momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paroles défilent en temps réel.\nTouchez une ligne pour y accéder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I testi sincronizzati scorrono in tempo reale.\nTocca una riga per saltare a quel momento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdgesynchroniseerde songtekst scrollt in realtime.\nTik op een regel om naar dat moment te springen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与时间同步的歌词实时滚动。\n轻点任意一行即可跳到该处。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизированный текст прокручивается в реальном времени.\nКоснитесь строки, чтобы перейти к этому моменту."
          }
        }
      }
    },
