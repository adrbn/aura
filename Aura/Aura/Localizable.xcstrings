        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladby z těchto žánrů se v mixu nikdy nepřehrají."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanger i disse sjangrene spilles aldri i en miks."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sange i disse genrer afspilles aldrig i et mix."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näiden tyylilajien kappaleita ei koskaan toisteta miksauksissa."
          }
        },
        "ro": {
