    "Songs in these genres never play in a mix.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux de ces genres ne passent jamais dans un mix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani di questi generi non entrano mai in un mix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones de estos géneros nunca suenan en una mezcla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs dieser Genres laufen nie in einem Mix."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cançons d'aquests gèneres no sonen mai en una mescla."
