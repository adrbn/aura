    "Click the translate button beside the lyrics to show or hide the translation.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes clic al botó de traducció al costat de la lletra per mostrar o amagar la traducció."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die Übersetzungsschaltfläche neben dem Songtext, um die Übersetzung ein- oder auszublenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el botón de traducción junto a la letra para mostrar u ocultar la traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur le bouton de traduction à côté des paroles pour afficher ou masquer la traduction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul pulsante di traduzione accanto al testo per mostrare o nascondere la traduzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de vertaalknop naast de songtekst om de vertaling te tonen of te verbergen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку перевода рядом с текстом, чтобы показать или скрыть перевод."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按歌词旁的翻译按钮即可显示或隐藏翻译。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på översättningsknappen bredvid låttexten för att visa eller dölja översättningen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clica no botão de tradução junto à letra para mostrar ou ocultar a tradução."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no botão de tradução ao lado da letra para mostrar ou ocultar a tradução."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij przycisk tłumaczenia obok tekstu, aby pokazać lub ukryć tłumaczenie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞の横の翻訳ボタンをクリックして、翻訳の表示/非表示を切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가사 옆의 번역 버튼을 클릭하면 번역을 표시하거나 숨길 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下歌詞旁的翻譯按鈕以顯示或隱藏翻譯。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím na tlačítko překladu vedle textu zobrazíš nebo skryješ překlad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på oversettelsesknappen ved siden av sangteksten for å vise eller skjule oversettelsen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på oversæt-knappen ved siden af sangteksten for at vise eller skjule oversættelsen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä tai piilota käännös sanojen vieressä olevalla käännöspainikkeella."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fă clic pe butonul de traducere de lângă versuri pentru a afișa sau ascunde traducerea."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку перекладу біля тексту, щоб показати чи сховати переклад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviriyi göstermek veya gizlemek için şarkı sözlerinin yanındaki çeviri düğmesine tıkla."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε κλικ στο κουμπί μετάφρασης δίπλα στους στίχους για να εμφανίσεις ή να αποκρύψεις τη μετάφραση."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกปุ่มแปลข้างเนื้อเพลงเพื่อแสดงหรือซ่อนคำแปล"
          }
        }
      }
    },
    "Sign in, click **Create API key**, then copy it.": {
