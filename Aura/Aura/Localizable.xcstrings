          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la portada en la página de la lista para cambiarla desde tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
