    "Download every song from your server. Choose \"Export to External Location\" to save to an external drive or custom folder.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa totes les cançons del teu servidor. Tria «Exportar a una ubicació externa» per desar-les en una unitat externa o una carpeta personalitzada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Titel von deinem Server herunterladen. „An externen Ort exportieren“ wählen, um auf einem externen Laufwerk oder einem eigenen Ordner zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga todas las canciones de tu servidor. Elige «Exportar a una ubicación externa» para guardarlas en una unidad externa o una carpeta personalizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger tous les titres du serveur. Choisir « Exporter vers un emplacement externe » pour enregistrer sur un disque externe ou un dossier personnalisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica tutti i brani dal tuo server. Scegli \"Esporta in posizione esterna\" per salvare su un'unità esterna o una cartella personalizzata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download alle nummers van je server. Kies \"Exporteren naar externe locatie\" om op te slaan op een externe schijf of eigen map."
          }
        }
      }
    },
