    "Listens to the song on this iPhone and places each line where it is sung": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute le morceau sur cet iPhone et place chaque ligne là où elle est chantée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta il brano su questo iPhone e mette ogni riga dove viene cantata"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha la canción en este iPhone y coloca cada línea donde se canta"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört den Song auf diesem iPhone an und setzt jede Zeile dorthin, wo sie gesungen wird"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolta la cançó en aquest iPhone i col·loca cada línia on es canta"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beluistert het nummer op deze iPhone en zet elke regel waar die gezongen wordt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 iPhone 上聆听歌曲，并把每一行放到演唱的位置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушает песню на этом iPhone и ставит каждую строку туда, где она поётся"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyssnar på låten på den här iPhonen och placerar varje rad där den sjungs"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouve a música neste iPhone e coloca cada linha onde é cantada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouve a música neste iPhone e coloca cada verso onde ele é cantado"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słucha utworu na tym iPhonie i umieszcza każdy wers tam, gdzie jest śpiewany"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneで曲を聴き、各行を歌われている位置に配置します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 곡을 듣고 각 가사를 부르는 위치에 맞춰요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這部 iPhone 上聆聽歌曲，並將每一行放在演唱的位置"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslechne skladbu na tomto iPhonu a umístí každý řádek tam, kde se zpívá"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lytter til sangen på denne iPhonen og plasserer hver linje der den synges"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lytter til sangen på denne iPhone og placerer hver linje, hvor den synges"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuuntelee kappaleen tässä iPhonessa ja sijoittaa jokaisen rivin kohtaan, jossa se lauletaan"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascultă melodia pe acest iPhone și plasează fiecare rând acolo unde este cântat"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухає пісню на цьому iPhone і ставить кожен рядок туди, де його співають"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkıyı bu iPhone'da dinler ve her satırı söylendiği yere yerleştirir"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακούει το τραγούδι σε αυτό το iPhone και τοποθετεί κάθε στίχο εκεί που τραγουδιέται"
          }
