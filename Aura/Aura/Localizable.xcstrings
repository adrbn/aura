          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella pagina della playlist, tieni premuta la copertina per sostituirla con una foto dalla tua libreria foto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de hoes op de playlistpagina ingedrukt om deze te wijzigen vanuit je fotobibliotheek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
