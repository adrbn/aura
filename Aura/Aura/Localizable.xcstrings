    "Add another server to switch between libraries — you can also switch straight from the Home title.": {
      "comment": "A description of the action to add a server.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix un altre servidor per canviar entre biblioteques — també pots canviar-hi directament des del títol d'Inici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen weiteren Server hinzufügen, um zwischen Bibliotheken zu wechseln — der Wechsel ist auch direkt über den Titel auf der Startseite möglich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade otro servidor para cambiar entre bibliotecas — también puedes cambiar directamente desde el título de Inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un autre serveur pour passer d'une bibliothèque à l'autre — le changement est aussi possible depuis le titre Accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un altro server per passare da una libreria all'altra — puoi farlo anche direttamente dal titolo Home."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een andere server toe om tussen bibliotheken te wisselen — dat kan ook direct vanaf de titel Start."
          }
        }
      }
    },
