    "Placed %lld of %lld lines by ear, word by word. Play it through, then Save.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lignes sur %2$lld placées à l’oreille, mot à mot. Écoutez jusqu’au bout, puis Enregistrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Zeilen nach Gehör gesetzt, Wort für Wort. Hör es durch, dann Sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld líneas colocadas de oído, palabra por palabra. Escúchala entera y luego Guardar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld righe su %2$lld posizionate a orecchio, parola per parola. Ascoltala tutta, poi Salva."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld línies col·locades d’oïda, paraula per paraula. Escolta-la sencera i després Desa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld van %2$lld regels op gehoor geplaatst, woord voor woord. Luister hem uit en tik dan op Bewaar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已凭听觉逐字放置 %2$lld 行中的 %1$lld 行。完整听一遍，然后存储。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расставлено на слух %1$lld из %2$lld строк, по словам. Дослушайте и нажмите «Сохранить»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Placerade %lld av %lld rader på gehör, ord för ord. Spela igenom den och tryck sedan på Spara."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld linhas colocadas de ouvido, palavra a palavra. Reproduz até ao fim e depois guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld versos posicionados de ouvido, palavra por palavra. Toque a música inteira e depois salve."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawiono ze słuchu %lld z %lld wersów, słowo po słowie. Odtwórz całość, potem Zapisz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld行を耳で聴き取り、単語ごとに配置しました。最後まで再生してから保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld줄을 귀로 듣고 단어별로 맞췄어요. 끝까지 재생한 다음 저장하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已逐字憑聽覺放置 %lld／%lld 行。請完整播放一次，然後儲存。"
          }
        }
      }
    },
    "Heard %lld of %lld lines: they were already in time. Their words are timed now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lignes sur %2$lld entendues : elles étaient déjà en rythme. Leurs mots sont maintenant calés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Zeilen gehört: Sie waren schon im Takt. Ihre Wörter sind jetzt getimt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld líneas oídas: ya iban a tiempo. Ahora sus palabras también."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld righe su %2$lld sentite: erano già a tempo. Ora lo sono anche le parole."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld línies sentides: ja anaven a temps. Ara les paraules també."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld van %2$lld regels gehoord: ze liepen al gelijk. Nu de woorden ook."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已听到 %2$lld 行中的 %1$lld 行：它们本来就同步。现在每个字也已对齐。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Услышано %1$lld из %2$lld строк: они уже совпадали. Теперь совпадают и слова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hörde %lld av %lld rader: de låg redan i takt. Deras ord är nu tajmade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld linhas ouvidas: já estavam sincronizadas. As palavras estão agora sincronizadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld versos ouvidos: já estavam no tempo. As palavras agora estão cronometradas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usłyszano %lld z %lld wersów: były już zsynchronizowane. Ich słowa są teraz zsynchronizowane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld行を聴き取りました。すでにタイミングが合っていたため、単語のタイミングを設定しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld줄을 들었고, 이미 타이밍이 맞아 있었어요. 이제 단어에도 타이밍이 맞춰졌어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽出 %lld／%lld 行：它們原本就已對上時間。現在已逐字標記時間。"
          }
        }
      }
    },
