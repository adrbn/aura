    "Download every song from your server. Choose \"Export to External Location\" to save to an external drive or custom folder.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa totes les cançons del teu servidor. Tria «Exportar a una ubicació externa» per desar-les en una unitat externa o una carpeta personalitzada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Titel von deinem Server herunterladen. „An externen Ort exportieren“ wählen, um auf einem externen Laufwerk oder einem eigenen Ordner zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga todas las canciones de tu servidor. Elige «Exportar a una ubicación externa» para guardarlas en una unidad externa o una carpeta personalizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger tous les titres du serveur. Choisir « Exporter vers un emplacement externe » pour enregistrer sur un disque externe ou un dossier personnalisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica tutti i brani dal tuo server. Scegli \"Esporta in posizione esterna\" per salvare su un'unità esterna o una cartella personalizzata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download alle nummers van je server. Kies \"Exporteren naar externe locatie\" om op te slaan op een externe schijf of eigen map."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载服务器上的所有歌曲。选择“导出到外部位置”可存储到外置驱动器或自定文件夹。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка всех песен с сервера. Выберите «Экспортировать во внешнее место», чтобы сохранить на внешний диск или в другую папку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda ner varje låt från din server. Välj \"Exportera till extern plats\" för att spara på en extern disk eller en egen mapp."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfere todas as músicas do teu servidor. Escolhe \"Exportar para localização externa\" para guardar num disco externo ou numa pasta à tua escolha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe todas as músicas do seu servidor. Escolha \"Exportar para local externo\" para salvar em um disco externo ou pasta personalizada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz każdy utwór z serwera. Wybierz „Eksportuj do zewnętrznej lokalizacji”, aby zapisać na dysku zewnętrznym lub w wybranym folderze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ上のすべての曲をダウンロードします。外付けドライブやカスタムフォルダに保存するには「外部の場所に書き出す」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 모든 곡을 다운로드해요. 외장 드라이브나 사용자 지정 폴더에 저장하려면 \"외부 위치로 내보내기\"를 선택하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載伺服器上的每一首歌曲。選擇「輸出到外部位置」即可儲存到外接硬碟或自訂資料夾。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhni každou skladbu ze svého serveru. Vyber „Exportovat na externí místo“ pro uložení na externí disk nebo do vlastní složky."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last ned alle sangene fra serveren din. Velg «Eksporter til ekstern plassering» for å lagre på en ekstern disk eller i en egen mappe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent alle sange fra din server. Vælg \"Eksporter til ekstern placering\" for at gemme på et eksternt drev eller en valgfri mappe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa kaikki kappaleet palvelimeltasi. Valitse ”Vie ulkoiseen sijaintiin” tallentaaksesi ulkoiselle levylle tai omaan kansioon."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă toate melodiile de pe server. Alege „Exportă într-o locație externă” pentru a salva pe un disc extern sau într-un dosar personalizat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажте всі пісні з сервера. Виберіть «Експортувати в зовнішнє місце», щоб зберегти на зовнішній диск або в іншу папку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucundaki tüm şarkıları indir. Harici bir sürücüye veya özel bir klasöre kaydetmek için “Harici Konuma Aktar”ı seç."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε λήψη κάθε τραγουδιού από τον διακομιστή σου. Επίλεξε «Εξαγωγή σε εξωτερική θέση» για αποθήκευση σε εξωτερικό δίσκο ή σε φάκελο της επιλογής σου."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดทุกเพลงจากเซิร์ฟเวอร์ของคุณ เลือก \"ส่งออกไปยังตำแหน่งภายนอก\" เพื่อบันทึกลงไดรฟ์ภายนอกหรือโฟลเดอร์ที่กำหนดเอง"
          }
        }
      }
    },
