    "All folders are shown. Select folders to filter content.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla mappar visas. Välj mappar för att filtrera innehållet."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as pastas estão visíveis. Seleciona pastas para filtrar o conteúdo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as pastas são exibidas. Selecione pastas para filtrar o conteúdo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie foldery są widoczne. Wybierz foldery, aby filtrować zawartość."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのフォルダを表示中です。フォルダを選択すると内容を絞り込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 폴더가 표시돼요. 폴더를 선택하면 콘텐츠를 걸러서 볼 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示所有資料夾。選取資料夾即可篩選內容。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazují se všechny složky. Vyber složky pro filtrování obsahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle mapper vises. Velg mapper for å filtrere innholdet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle mapper vises. Vælg mapper for at filtrere indholdet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki kansiot näytetään. Suodata sisältöä valitsemalla kansioita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt afișate toate dosarele. Selectează dosare pentru a filtra conținutul."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано всі папки. Виберіть папки, щоб фільтрувати вміст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm klasörler gösteriliyor. İçeriği süzmek için klasör seç."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζονται όλοι οι φάκελοι. Επίλεξε φακέλους για φιλτράρισμα του περιεχομένου."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงทุกโฟลเดอร์ เลือกโฟลเดอร์เพื่อกรองเนื้อหา"
          }
        }
      }
    },
