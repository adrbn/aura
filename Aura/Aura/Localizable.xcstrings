    "Your downloads are not touched, and anything cleared is fetched again next time you play it.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves baixades no es toquen, i el que es buidi es tornarà a obtenir la propera vegada que ho reprodueixis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Downloads bleiben unberührt, und alles Geleerte wird beim nächsten Abspielen erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus descargas no se tocan, y lo que se vacíe se volverá a obtener la próxima vez que lo reproduzcas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos téléchargements ne sont pas touchés, et tout ce qui est vidé sera récupéré à nouveau à la prochaine lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi download non vengono toccati, e ciò che viene svuotato sarà recuperato di nuovo alla prossima riproduzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je downloads blijven onaangeroerd, en wat gewist wordt, wordt opnieuw opgehaald zodra je het weer afspeelt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的下载内容不受影响，清除的内容会在下次播放时重新获取。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши загрузки не затрагиваются, а все очищенное будет загружено заново при следующем воспроизведении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina nedladdningar berörs inte, och allt som rensas hämtas igen nästa gång du spelar det."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas transferências não são afetadas, e tudo o que for limpo é obtido novamente da próxima vez que o reproduzires."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus downloads não são afetados, e o que for limpo é baixado de novo na próxima vez que você tocar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pobrane utwory pozostają nietknięte, a wszystko, co wyczyszczono, zostanie pobrane ponownie przy następnym odtworzeniu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードには影響しません。消去した項目は、次に再生するときに再取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 항목은 그대로 두고, 지운 항목은 다음에 재생할 때 다시 가져와요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的下載項目不會受到影響，清除的內容會在你下次播放時重新取得。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše stažené skladby zůstanou nedotčené a vše, co se vymaže, se při dalším přehrání stáhne znovu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedlastingene dine berøres ikke, og alt som tømmes, hentes på nytt neste gang du spiller det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine overførsler berøres ikke, og alt, der ryddes, hentes igen, næste gang du afspiller det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Latauksiisi ei kosketa, ja kaikki tyhjennetty haetaan uudelleen, kun seuraavan kerran toistat sen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcările tale nu sunt atinse, iar orice e golit se obține din nou data viitoare când îl redai."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші завантаження не зачіпаються, а все очищене буде завантажено знову при наступному відтворенні."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenlerine dokunulmaz, temizlenen her şey bir dahaki çalışında yeniden alınır."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λήψεις σου δεν επηρεάζονται, και ό,τι διαγραφεί ανακτάται ξανά την επόμενη φορά που θα το παίξεις."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการดาวน์โหลดของคุณจะไม่ถูกแตะต้อง และสิ่งที่ล้างออกจะถูกดึงมาใหม่เมื่อคุณเล่นครั้งถัดไป"
          }
        }
      }
    },
    "Your library. Your server.\nNothing in between.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva biblioteca. El teu servidor.\nRes entremig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek. Dein Server.\nNichts dazwischen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca. Tu servidor.\nNada en medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque. Votre serveur.\nRien entre les deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria. Il tuo server.\nNiente in mezzo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bibliotheek. Je server.\nNiets ertussen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的资料库。你的服务器。\n中间什么都没有。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша медиатека. Ваш сервер.\nНичего лишнего посередине."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt bibliotek. Din server.\nInget emellan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua biblioteca. O teu servidor.\nNada pelo meio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca. Seu servidor.\nNada no meio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja biblioteka. Twój serwer.\nNic pomiędzy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのライブラリ。あなたのサーバ。\n間に何もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 보관함. 내 서버.\n그 사이엔 아무것도 없어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的資料庫。你的伺服器。\n中間沒有任何阻隔。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše knihovna. Váš server.\nNic mezi tím."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteket ditt. Serveren din.\nIngenting imellom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bibliotek. Din server.\nIntet imellem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjastosi. Palvelimesi.\nEi mitään välissä."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca ta. Serverul tău.\nNimic la mijloc."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша медіатека. Ваш сервер.\nНічого посередині."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivin. Sunucun.\nArada hiçbir şey yok."
          }
