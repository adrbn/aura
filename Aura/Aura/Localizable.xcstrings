    "Click the translate button beside the lyrics to show or hide the translation.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes clic al botó de traducció al costat de la lletra per mostrar o amagar la traducció."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die Übersetzungsschaltfläche neben dem Songtext, um die Übersetzung ein- oder auszublenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el botón de traducción junto a la letra para mostrar u ocultar la traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur le bouton de traduction à côté des paroles pour afficher ou masquer la traduction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul pulsante di traduzione accanto al testo per mostrare o nascondere la traduzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de vertaalknop naast de songtekst om de vertaling te tonen of te verbergen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку перевода рядом с текстом, чтобы показать или скрыть перевод."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
