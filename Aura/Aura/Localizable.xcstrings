    "Resumes Aura, or starts something if nothing is loaded.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprèn l'Aura, o comença a reproduir alguna cosa si no hi ha res carregat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt Aura fort oder startet etwas, wenn nichts geladen ist."
          }
        },
