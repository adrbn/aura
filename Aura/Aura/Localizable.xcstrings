    "Your music, everywhere.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva música, a tot arreu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Musik, überall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu música, en todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre musique, partout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua musica, ovunque."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw muziek, overal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的音乐，随处可听。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша музыка — везде."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din musik, överallt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua música, em todo o lado."
          }
        },
