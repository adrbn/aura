    "Their new releases come back to the radar at its next daily pass.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les seves novetats tornen al radar en el pròxim pas diari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Neuerscheinungen erscheinen beim nächsten täglichen Durchlauf wieder im Radar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus novedades volverán al radar en su próximo paso diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses nouveautés reviennent sur le radar à son prochain passage quotidien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le loro nuove uscite tornano sul radar al prossimo passaggio giornaliero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hun nieuwe releases verschijnen weer op de radar bij de volgende dagelijkse ronde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其新发行会在雷达下次每日更新时回来。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их новинки вернутся на радар при следующем ежедневном обновлении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Deras nya utgåvor kommer tillbaka till radarn vid nästa dagliga genomgång."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os novos lançamentos deles voltam ao radar na próxima passagem diária."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os novos lançamentos deles voltam ao radar na próxima passagem diária."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich nowe wydania wrócą do radaru przy następnym codziennym przebiegu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新作は、次回の毎日の更新でレーダーに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 아티스트의 새 릴리스는 다음 일일 확인 때 레이더에 다시 나타나요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他們的新發行會在雷達下一次每日檢查時回來。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejich nová vydání se na radar vrátí při dalším denním průchodu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De nye utgivelsene deres kommer tilbake på radaren ved neste daglige gjennomgang."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deres nye udgivelser vender tilbage til radaren ved dens næste daglige gennemgang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Niiden uudet julkaisut palaavat tutkaan seuraavalla päivittäisellä kierroksella."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lansările noi revin pe radar la următoarea trecere zilnică."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їхні нові релізи повернуться на радар під час наступної щоденної перевірки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni çıkışları, radarın bir sonraki günlük taramasında geri gelir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι νέες κυκλοφορίες τους επιστρέφουν στο ραντάρ στον επόμενο ημερήσιο έλεγχο."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลงานใหม่ของพวกเขาจะกลับมาในเรดาร์ในรอบประจำวันถัดไป"
          }
        }
      }
    },
