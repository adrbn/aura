        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una canción traducida una vez se guarda en este iPhone, y vuelve a aparecer sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chanson traduite une fois reste sur cet iPhone, même hors ligne."
