        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Белые подписи плохо читаются на этом цвете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vita etiketter är svåra att läsa på den här färgen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os rótulos brancos são difíceis de ler nesta cor."
          }
        },
