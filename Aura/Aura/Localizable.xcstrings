    "Connect to your Navidrome server\nto start listening": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecta't al teu servidor Navidrome\nper començar a escoltar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Navidrome-Server verbinden,\num mit dem Hören zu beginnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta con tu servidor Navidrome\npara empezar a escuchar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter à votre serveur Navidrome\npour commencer l'écoute"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti al tuo server Navidrome\nper iniziare ad ascoltare"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind met je Navidrome-server\nom te beginnen met luisteren"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到你的 Navidrome 服务器\n开始聆听"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к серверу Navidrome,\nчтобы начать слушать"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut till din Navidrome-server\nför att börja lyssna"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga-te ao teu servidor Navidrome\npara começar a ouvir"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se ao seu servidor Navidrome\npara começar a ouvir"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z serwerem Navidrome,\naby zacząć słuchać"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Navidromeサーバに接続して\n聴き始めましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Navidrome 서버에 연결해서\n음악을 들어 보세요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接你的 Navidrome 伺服器\n開始聆聽"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připoj se k serveru Navidrome\na začni poslouchat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til Navidrome-serveren din\nfor å begynne å lytte"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret forbindelse til din Navidrome-server\nfor at begynde at lytte"
