    "%@ A self-signed certificate will do this — try http:// if the server is on your own network.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Un certificat autosignat ho pot provocar — prova http:// si el servidor és a la teva pròpia xarxa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ein selbstsigniertes Zertifikat kann das verursachen — versuche http://, wenn der Server in deinem eigenen Netzwerk ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Un certificado autofirmado puede causarlo — prueba http:// si el servidor está en tu propia red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Un certificat auto-signé peut en être la cause — essayez http:// si le serveur est sur votre propre réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Può dipendere da un certificato autofirmato — prova http:// se il server è sulla tua rete."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Een zelfondertekend certificaat kan dit veroorzaken — probeer http:// als de server op je eigen netwerk staat."
          }
        }
      }
    },
