    "Give a host name or an IP, with or without https://.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un nom d'amfitrió o una IP, amb o sense https://."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Hostnamen oder eine IP an, mit oder ohne https://."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un nombre de host o una IP, con o sin https://."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez un nom d'hôte ou une IP, avec ou sans https://."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un nome host o un IP, con o senza https://."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef een hostnaam of IP-adres op, met of zonder https://."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写主机名或 IP，可带或不带 https://。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите имя хоста или IP-адрес, с https:// или без."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ett värdnamn eller en IP-adress, med eller utan https://."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica um nome de anfitrião ou um IP, com ou sem https://."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe um nome de host ou um IP, com ou sem https://."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj nazwę hosta lub adres IP, z https:// lub bez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト名またはIPアドレスを入力してください。https://は付けても付けなくても構いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 이름이나 IP를 입력하세요. https://는 있어도 없어도 돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請提供主機名稱或 IP，可加上或不加 https://。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte název hostitele nebo IP adresu, s https:// nebo bez."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi et vertsnavn eller en IP-adresse, med eller uten https://."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv et værtsnavn eller en IP-adresse, med eller uden https://."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna isäntänimi tai IP-osoite, https:// kanssa tai ilman."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu un nume de gazdă sau un IP, cu sau fără https://."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть ім’я хоста або IP, з https:// чи без."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana bilgisayar adı veya IP gir, https:// ile ya da olmadan."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώσε όνομα host ή IP, με ή χωρίς https://."
