            "value": "Amb el pla gratuït de Google, el que envies es pot fer servir per millorar els seus productes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im kostenlosen Google-Tarif kann das Gesendete zur Verbesserung der Google-Produkte verwendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
