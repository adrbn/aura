    "Lossless files will be transcoded to MP3 at %lld kbps. Incompatible formats (OGG/Opus) are auto-transcoded.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els fitxers sense pèrdua es transcodificaran a MP3 a %lld kbps. Els formats incompatibles (OGG/Opus) es transcodifiquen automàticament."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlustfreie Dateien werden mit %lld kbps in MP3 umgewandelt. Inkompatible Formate (OGG/Opus) werden automatisch umgewandelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos sin pérdida se transcodificarán a MP3 a %lld kbps. Los formatos incompatibles (OGG/Opus) se transcodifican automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sans perte seront transcodés en MP3 à %lld kbps. Les formats incompatibles (OGG/Opus) sont transcodés automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file senza perdita verranno transcodificati in MP3 a %lld kbps. I formati incompatibili (OGG/Opus) vengono transcodificati automaticamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lossless-bestanden worden getranscodeerd naar MP3 op %lld kbps. Incompatibele formaten (OGG/Opus) worden automatisch getranscodeerd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无损文件将转码为 %lld kbps 的 MP3。不兼容的格式（OGG/Opus）会自动转码。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы без потерь будут перекодированы в MP3 с битрейтом %lld кбит/с. Несовместимые форматы (OGG/Opus) перекодируются автоматически."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förlustfria filer kodas om till MP3 med %lld kbit/s. Format som inte stöds (OGG/Opus) kodas om automatiskt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros sem perdas serão convertidos para MP3 a %lld kbps. Os formatos incompatíveis (OGG/Opus) são convertidos automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos sem perdas serão transcodificados para MP3 a %lld kbps. Formatos incompatíveis (OGG/Opus) são transcodificados automaticamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki bezstratne będą transkodowane do MP3 z prędkością %lld kb/s. Niezgodne formaty (OGG/Opus) są transkodowane automatycznie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロスレスファイルは%lld kbpsのMP3にトランスコードされます。非対応の形式(OGG/Opus)は自動でトランスコードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무손실 파일은 %lld kbps의 MP3로 변환돼요. 호환되지 않는 형식(OGG/Opus)은 자동으로 변환돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無損檔案將以 %lld kbps 轉碼為 MP3。不相容的格式（OGG/Opus）會自動轉碼。"
          }
        }
      }
    },
