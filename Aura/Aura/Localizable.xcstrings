    "Time-synced lyrics scroll in real time.\nTap any line to jump to that moment.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La lletra sincronitzada es desplaça en temps real.\nToca una línia per saltar a aquest moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitsynchronisierter Songtext läuft in Echtzeit mit.\nTippe auf eine Zeile, um zu diesem Moment zu springen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La letra avanza en tiempo real, sincronizada.\nToca cualquier línea para saltar a ese momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paroles défilent en temps réel.\nTouchez une ligne pour y accéder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I testi sincronizzati scorrono in tempo reale.\nTocca una riga per saltare a quel momento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdgesynchroniseerde songtekst scrollt in realtime.\nTik op een regel om naar dat moment te springen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与时间同步的歌词实时滚动。\n轻点任意一行即可跳到该处。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизированный текст прокручивается в реальном времени.\nКоснитесь строки, чтобы перейти к этому моменту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidssynkad låttext rullar i realtid.\nTryck på valfri rad för att hoppa till det ögonblicket."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As letras sincronizadas deslizam em tempo real.\nToca em qualquer linha para saltar para esse momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As letras sincronizadas rolam em tempo real.\nToque em qualquer linha para ir àquele momento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksty zsynchronizowane z czasem przewijają się na żywo.\nStuknij dowolny wiersz, aby przeskoczyć do tego momentu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間に同期した歌詞がリアルタイムでスクロールします。\n任意の行をタップすると、その場面にジャンプします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간에 맞춰 가사가 실시간으로 스크롤돼요.\n아무 줄이나 탭하면 그 순간으로 이동해요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與時間同步的歌詞即時捲動。\n點一下任一行即可跳到該時刻。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Texty synchronizované s časem se posouvají v reálném čase.\nKlepnutím na řádek skočíš na dané místo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidssynkroniserte sangtekster ruller i sanntid.\nTrykk på en linje for å hoppe dit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidssynkroniserede sangtekster ruller i realtid.\nTryk på en linje for at springe til det øjeblik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajastetut sanat vierivät reaaliajassa.\nSiirry hetkeen napauttamalla mitä tahansa riviä."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versurile sincronizate derulează în timp real.\nAtinge orice rând pentru a sări la acel moment."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізовані тексти прокручуються в реальному часі.\nТоркніться рядка, щоб перейти до цього моменту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlı sözler gerçek zamanlı kayar.\nO âna atlamak için bir satıra dokun."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συγχρονισμένοι στίχοι κυλούν σε πραγματικό χρόνο.\nΠάτησε μια γραμμή για να πας σε εκείνη τη στιγμή."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อเพลงซิงค์เวลาเลื่อนตามแบบเรียลไทม์\nแตะบรรทัดใดก็ได้เพื่อข้ามไปยังช่วงนั้น"
          }
        }
      }
    },
