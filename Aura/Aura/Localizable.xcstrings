    "Keep listening — your top songs, artists, and genres for %@ will appear here as you play music.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueix escoltant — les teves cançons, artistes i gèneres més escoltats de %@ apareixeran aquí a mesura que reprodueixis música."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiterhören — deine meistgehörten Titel, Interpreten und Genres für %@ erscheinen hier, sobald du Musik hörst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue escuchando — tus canciones, artistas y géneros más escuchados de %@ aparecerán aquí a medida que reproduzcas música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres, artistes et genres les plus écoutés de %@ apparaîtront ici au fil des écoutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua ad ascoltare — i tuoi brani, artisti e generi più ascoltati di %@ appariranno qui mentre ascolti musica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf luisteren — je populairste nummers, artiesten en genres voor %@ verschijnen hier naarmate je muziek afspeelt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续聆听 — 你在 %@ 最常听的歌曲、艺人和风格将随着播放显示在这里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте слушать — ваши любимые песни, артисты и жанры за %@ появятся здесь по мере прослушивания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt lyssna – dina mest spelade låtar, artister och genrer för %@ visas här medan du spelar musik."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a ouvir — as tuas músicas, artistas e géneros mais ouvidos de %@ vão aparecer aqui à medida que ouves música."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue ouvindo — suas músicas, artistas e gêneros mais ouvidos de %@ vão aparecer aqui conforme você toca música."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słuchaj dalej — Twoje najczęściej słuchane utwory, wykonawcy i gatunki dla: %@ pojawią się tutaj w miarę odtwarzania muzyki."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま聴き続けると、%@のトップソング、アーティスト、ジャンルがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 들어 보세요. 음악을 재생하면 %@의 인기 곡, 아티스트, 장르가 여기에 표시돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續聆聽，播放音樂時，你在 %@ 的熱門歌曲、演出者和曲風會顯示在這裡。"
          }
        }
      }
    },
