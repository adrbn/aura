    "Search for songs and download them from the Search tab.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca cançons i baixa-les des de la pestanya Cercar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel im Tab „Suche“ suchen und herunterladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca canciones y descárgalas desde la pestaña Buscar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher des titres et les télécharger depuis l'onglet Rechercher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca i brani e scaricali dalla scheda Cerca."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek nummers en download ze vanaf het tabblad Zoeken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“搜索”标签页中搜索并下载歌曲。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите песни и загружайте их на вкладке «Поиск»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök efter låtar och ladda ner dem från fliken Sök."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura músicas e transfere-as no separador Pesquisa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque músicas e baixe-as pela aba Buscar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukaj utwory i pobierz je z karty Szukaj."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲を検索して、検索タブからダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡을 검색해서 검색 탭에서 다운로드하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋歌曲，並從「搜尋」標籤頁下載。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledej skladby a stáhni je na kartě Hledat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk etter sanger og last dem ned fra Søk-fanen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søg efter sange, og hent dem fra fanen Søg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hae kappaleita ja lataa ne Haku-välilehdeltä."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută melodii și descarcă-le din fila Caută."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукайте пісні й завантажуйте їх на вкладці «Пошук»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara sekmesinden şarkı arayıp indir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζήτησε τραγούδια και κάνε λήψη τους από την καρτέλα Αναζήτηση."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาเพลงแล้วดาวน์โหลดจากแถบค้นหา"
          }
        }
      }
    },
