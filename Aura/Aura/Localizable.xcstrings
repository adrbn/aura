        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要下載這個播放列表中的全部 %lld 首歌曲嗎？"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhnout všechny skladby (%lld) z tohoto playlistu?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du laste ned alle %lld sangene i denne spillelisten?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du hente alle %lld sange i denne spilleliste?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladataanko kaikki tämän soittolistan %lld kappaletta?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarci toate cele %lld melodii din acest playlist?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажити всі пісні цього плейлиста (%lld)?"
