    "Offline results — downloaded and cached songs only": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultats sense connexió — només cançons baixades i en memòria cau"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Ergebnisse — nur heruntergeladene und zwischengespeicherte Titel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultados sin conexión — solo canciones descargadas y en caché"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résultats hors ligne — titres téléchargés et en cache uniquement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risultati offline — solo brani scaricati e in cache"
          }
        },
        "nl": {
