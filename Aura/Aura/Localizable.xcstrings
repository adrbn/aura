    "New releases from the artists you play most, found in Deezer's public catalogue. Only artist names are sent.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Novetats dels artistes que més escoltes, trobades al catàleg públic de Deezer. Només s'envien els noms dels artistes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuerscheinungen deiner meistgehörten Interpreten, gefunden im öffentlichen Katalog von Deezer. Es werden nur Interpretennamen gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Novedades de los artistas que más escuchas, encontradas en el catálogo público de Deezer. Solo se envían los nombres de los artistas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveautés des artistes que vous écoutez le plus, trouvées dans le catalogue public de Deezer. Seuls les noms d’artistes sont envoyés."
          }
        },
        "it": {
