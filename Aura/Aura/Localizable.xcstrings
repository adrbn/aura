    "Your entire library at your fingertips.\nLossless or transcoded, your choice.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tota la teva biblioteca a l'abast de la mà.\nSense pèrdua o transcodificada, tu tries."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gesamte Bibliothek immer griffbereit.\nVerlustfrei oder umgewandelt, du entscheidest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda tu biblioteca al alcance de tu mano.\nSin pérdida o transcodificada, tú eliges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute votre bibliothèque à portée de main.\nSans perte ou transcodé, à vous de choisir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta la tua libreria a portata di mano.\nSenza perdita di qualità o transcodificata, a tua scelta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hele bibliotheek binnen handbereik.\nLossless of getranscodeerd, jij kiest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个资料库触手可及。\n无损或转码，由你选择。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся медиатека у вас под рукой.\nБез потерь или с перекодированием — на ваш выбор."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela ditt bibliotek inom räckhåll.\nFörlustfritt eller omkodat, du väljer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a tua biblioteca à distância de um toque.\nSem perdas ou convertida, tu escolhes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca inteira na ponta dos dedos.\nSem perdas ou transcodificada, você escolhe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała Twoja biblioteka w zasięgu ręki.\nBezstratnie lub transkodowana, wybierasz Ty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ全体がすぐ手元に。\nロスレスでもトランスコードでも、お好みで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함 전체를 손끝에서.\n무손실 또는 변환, 원하는 대로 고르세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的整個資料庫盡在指尖。\n無損或轉碼，由你選擇。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celá tvá knihovna na dosah ruky.\nBezeztrátově nebo překódovaně, jak chceš."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele biblioteket ditt lett tilgjengelig.\nTapsfritt eller omkodet, du velger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele dit bibliotek lige ved hånden.\nLossless eller omkodet – du vælger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko kirjastosi ulottuvillasi.\nHäviötön tai transkoodattu, sinä päätät."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toată biblioteca ta la îndemână.\nLossless sau transcodat, alegerea e a ta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уся ваша медіатека під рукою.\nБез втрат чи з перекодуванням — на ваш вибір."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm arşivin parmaklarının ucunda.\nKayıpsız ya da dönüştürülmüş, seçim senin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλη η βιβλιοθήκη σου στα χέρια σου.\nLossless ή με μετατροπή, εσύ διαλέγεις."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งคลังของคุณอยู่แค่ปลายนิ้ว\nLossless หรือแปลงไฟล์ คุณเลือกได้"
          }
        }
      }
    },
