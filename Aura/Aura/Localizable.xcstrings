    "This SharePlay plays from another server. Everyone needs an account on the same one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce SharePlay joue depuis un autre serveur. Tout le monde doit avoir un compte sur le même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo SharePlay riproduce da un altro server. Tutti devono avere un account sullo stesso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este SharePlay reproduce desde otro servidor. Todos necesitan una cuenta en el mismo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses SharePlay spielt von einem anderen Server. Alle brauchen ein Konto auf demselben."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest SharePlay reprodueix des d’un altre servidor. Tothom necessita un compte al mateix."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze SharePlay speelt af vanaf een andere server. Iedereen heeft een account op dezelfde nodig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此同播共享来自另一台服务器。所有人都需要在同一台服务器上拥有帐户。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот SharePlay воспроизводится с другого сервера. Всем нужна учетная запись на одном и том же."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här SharePlay-sessionen spelar från en annan server. Alla behöver ett konto på samma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este SharePlay reproduz a partir de outro servidor. Todos precisam de uma conta no mesmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este SharePlay toca de outro servidor. Todos precisam ter uma conta no mesmo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten SharePlay odtwarza z innego serwera. Wszyscy muszą mieć konto na tym samym."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このSharePlayは別のサーバから再生されます。全員が同じサーバのアカウントを持っている必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 SharePlay는 다른 서버에서 재생돼요. 모두 같은 서버의 계정이 필요해요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 SharePlay 是從另一個伺服器播放。所有人都需要在同一個伺服器上有帳號。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento SharePlay přehrává z jiného serveru. Všichni potřebují účet na tom samém."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne SharePlay-økten spiller fra en annen server. Alle trenger en konto på den samme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne SharePlay afspiller fra en anden server. Alle skal have en konto på den samme."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä SharePlay toistaa toiselta palvelimelta. Kaikilla on oltava tili samalla palvelimella."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest SharePlay redă de pe alt server. Toată lumea are nevoie de un cont pe același server."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей SharePlay відтворює з іншого сервера. Кожному потрібен обліковий запис на тому самому сервері."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu SharePlay başka bir sunucudan çalıyor. Herkesin aynı sunucuda hesabı olmalı."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το SharePlay παίζει από άλλον διακομιστή. Όλοι χρειάζονται λογαριασμό στον ίδιο."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "SharePlay นี้เล่นจากเซิร์ฟเวอร์อื่น ทุกคนต้องมีบัญชีบนเซิร์ฟเวอร์เดียวกัน"
          }
        }
      }
    },
