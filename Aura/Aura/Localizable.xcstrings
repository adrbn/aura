    "Streamed songs are cached automatically and may be cleared by iOS when storage is low. Downloads are permanent.": {},
    "Streams original files (FLAC/ALAC). Uses more data. Incompatible formats (OGG/Opus) are auto-transcoded.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprodueix en continu els fitxers originals (FLAC/ALAC). Consumeix més dades. Els formats incompatibles (OGG/Opus) es transcodifiquen automàticament."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamt die Originaldateien (FLAC/ALAC). Verbraucht mehr Datenvolumen. Inkompatible Formate (OGG/Opus) werden automatisch umgewandelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce los archivos originales (FLAC/ALAC). Usa más datos. Los formatos incompatibles (OGG/Opus) se transcodifican automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffuse les fichiers d'origine (FLAC/ALAC). Consomme plus de données. Les formats incompatibles (OGG/Opus) sont transcodés automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasmette i file originali (FLAC/ALAC). Consuma più dati. I formati incompatibili (OGG/Opus) vengono transcodificati automaticamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamt de originele bestanden (FLAC/ALAC). Verbruikt meer data. Incompatibele formaten (OGG/Opus) worden automatisch getranscodeerd."
          }
        }
      }
    },
