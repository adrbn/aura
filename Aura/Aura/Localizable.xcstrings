    "The time of day mix follows the hour: morning, afternoon, evening or late night.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mix du moment suit l'heure : matin, après-midi, soir ou nuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mix del momento segue l'ora: mattina, pomeriggio, sera o notte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mezcla del momento sigue la hora: mañana, tarde, noche o madrugada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tageszeit-Mix folgt der Uhrzeit: Morgen, Nachmittag, Abend oder Nacht."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La mescla del moment segueix l'hora: matí, tarda, vespre o nit."
          }
        },
        "nl": {
