    "Positive shows the words earlier. Bluetooth headphones usually need a nudge.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor positiu mostra les paraules abans. Els auriculars Bluetooth solen necessitar un petit ajust."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein positiver Wert zeigt die Wörter früher an. Bluetooth-Kopfhörer brauchen meist einen kleinen Versatz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor positivo adelanta las palabras. Los auriculares Bluetooth suelen necesitar un pequeño ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une valeur positive affiche les mots plus tôt. Les écouteurs Bluetooth demandent souvent un petit décalage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valore positivo mostra le parole prima. Le cuffie Bluetooth di solito richiedono un piccolo scarto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een positieve waarde toont de woorden eerder. Bluetooth-koptelefoons hebben vaak een kleine correctie nodig."
          }
        }
      }
    },
