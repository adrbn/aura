    "A song translated once is kept on this iPhone, and comes back offline.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cançó traduïda una vegada es queda en aquest iPhone i torna a aparèixer sense connexió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einmal übersetzter Songtext bleibt auf diesem iPhone gespeichert und ist auch offline verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una canción traducida una vez se guarda en este iPhone, y vuelve a aparecer sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chanson traduite une fois reste sur cet iPhone, même hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brano tradotto una volta resta su questo iPhone, anche offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nummer dat eenmaal vertaald is, blijft op deze iPhone staan en werkt ook offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲翻译一次后会保留在这台 iPhone 上，离线时也能显示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Однажды переведенная песня сохраняется на этом iPhone и доступна офлайн."
          }
        }
      }
    },
