    "Playlists appear here once some of their songs are downloaded or cached": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spellistor visas här när några av deras låtar har laddats ner eller cachats"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As listas aparecem aqui assim que algumas das suas músicas forem transferidas ou colocadas em cache"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As playlists aparecem aqui quando algumas das músicas são baixadas ou ficam em cache"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlisty pojawią się tutaj, gdy część ich utworów zostanie pobrana lub zapisana w pamięci podręcznej"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲の一部がダウンロードまたはキャッシュされると、プレイリストがここに表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡 일부를 다운로드하거나 캐시하면 재생목록이 여기에 표시돼요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載或快取其中一些歌曲後，播放列表就會顯示在這裡"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlisty se tu objeví, jakmile se stáhnou nebo uloží některé jejich skladby"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillelister vises her når noen av sangene deres er lastet ned eller bufret"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillelister vises her, når nogle af deres sange er hentet eller cachelagret"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soittolistat näkyvät täällä, kun osa niiden kappaleista on ladattu tai välimuistissa"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlisturile apar aici după ce unele dintre melodiile lor sunt descărcate sau în cache"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плейлисти з’являться тут, коли частину їхніх пісень буде завантажено чи кешовано"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalma listeleri, şarkılarından bazıları indirildiğinde veya önbelleğe alındığında burada görünür"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λίστες εμφανίζονται εδώ μόλις κάποια από τα τραγούδια τους ληφθούν ή αποθηκευτούν προσωρινά"
          }
        },
        "th": {
