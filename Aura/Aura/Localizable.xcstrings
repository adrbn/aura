    "Your timing for this song is deleted and the lyrics are looked up again.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva sincronització d'aquesta cançó se suprimeix i la lletra es torna a cercar."
          }
        },
