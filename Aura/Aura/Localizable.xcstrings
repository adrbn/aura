    "Long-press the cover art on the playlist page to change it from your photo library.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A la pàgina de la playlist, mantén premuda la portada per canviar-la des de la teva fototeca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Cover auf der Playlist-Seite gedrückt, um es aus deiner Fotomediathek zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la portada en la página de la lista para cambiarla desde tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la page de la playlist, toucher la pochette de manière prolongée pour la remplacer depuis la photothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella pagina della playlist, tieni premuta la copertina per sostituirla con una foto dalla tua libreria foto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de hoes op de playlistpagina ingedrukt om deze te wijzigen vanuit je fotobibliotheek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在播放列表页面长按封面，即可从照片图库更换。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь обложки на странице плейлиста и удерживайте, чтобы заменить ее фото из медиатеки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och håll på omslaget på spellistesidan för att byta det mot en bild från ditt fotobibliotek."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prime sem soltar a capa na página da lista para a alterar a partir da tua fototeca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionada a capa na página da playlist para alterá-la a partir da sua fototeca."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj okładkę na stronie playlisty, aby zmienić ją na zdjęcie z biblioteki zdjęć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイリストのページでカバーアートを長押しすると、写真ライブラリから変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생목록 페이지에서 커버 아트를 길게 누르면 사진 보관함에서 바꿀 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按播放列表頁面上的封面圖片，即可從你的照片圖庫更改。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlouhým stisknutím obalu na stránce playlistu ho změníš na fotku z knihovny fotek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold inne omslaget på spillelistesiden for å endre det fra bildebiblioteket ditt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold fingeren på albumbilledet på spillelistens side for at ændre det fra dit fotobibliotek."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda kansikuva kuvakirjastostasi painamalla pitkään soittolistasivun kansikuvaa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă lung pe copertă în pagina playlistului pentru a o schimba din biblioteca foto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте обкладинку на сторінці плейлиста, щоб змінити її з фотобібліотеки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf arşivinden değiştirmek için çalma listesi sayfasındaki kapağa uzun bas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε παρατεταμένα το εξώφυλλο στη σελίδα της λίστας για να το αλλάξεις από τη βιβλιοθήκη φωτογραφιών σου."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะภาพปกค้างไว้ในหน้าเพลย์ลิสต์เพื่อเปลี่ยนจากคลังรูปภาพของคุณ"
          }
        }
      }
    },
