    "Tap the translate button above the lyrics to show or hide the translation.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botó de traducció per sobre de la lletra per mostrar o amagar la traducció."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Übersetzungsschaltfläche über dem Songtext, um die Übersetzung ein- oder auszublenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de traducción encima de la letra para mostrar u ocultar la traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher le bouton de traduction au-dessus des paroles pour afficher ou masquer la traduction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante di traduzione sopra il testo per mostrare o nascondere la traduzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de vertaalknop boven de songtekst om de vertaling te tonen of te verbergen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点歌词上方的翻译按钮即可显示或隐藏翻译。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь кнопки перевода над текстом, чтобы показать или скрыть перевод."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på översättningsknappen ovanför låttexten för att visa eller dölja översättningen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no botão de tradução por cima da letra para mostrar ou ocultar a tradução."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de tradução acima da letra para mostrar ou ocultar a tradução."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij przycisk tłumaczenia nad tekstem, aby pokazać lub ukryć tłumaczenie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞の上の翻訳ボタンをタップして、翻訳の表示/非表示を切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가사 위의 번역 버튼을 탭하면 번역을 표시하거나 숨길 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下歌詞上方的翻譯按鈕以顯示或隱藏翻譯。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na tlačítko překladu nad textem zobrazíte nebo skryjete překlad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på oversettelsesknappen over sangteksten for å vise eller skjule oversettelsen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på oversæt-knappen over sangteksten for at vise eller skjule oversættelsen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä tai piilota käännös sanojen yläpuolella olevalla käännöspainikkeella."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge butonul de traducere de deasupra versurilor pentru a afișa sau ascunde traducerea."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться кнопки перекладу над текстом, щоб показати чи сховати переклад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviriyi göstermek veya gizlemek için sözlerin üstündeki çeviri düğmesine dokun."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε το κουμπί μετάφρασης πάνω από τους στίχους για να εμφανίσεις ή να αποκρύψεις τη μετάφραση."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มแปลเหนือเนื้อเพลงเพื่อแสดงหรือซ่อนคำแปล"
          }
        }
      }
    },
