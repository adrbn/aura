    "Playlists show up here once some of their songs are on this iPhone.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les playlists apareixen aquí quan algunes de les seves cançons són en aquest iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlists erscheinen hier, sobald einige ihrer Titel auf diesem iPhone sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas aparecen aquí en cuanto algunas de sus canciones están en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les playlists apparaissent ici dès que certains de leurs titres sont sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le playlist compaiono qui non appena alcuni dei loro brani sono su questo iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlists verschijnen hier zodra enkele van hun nummers op deze iPhone staan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放列表中有歌曲存入这台 iPhone 后，就会显示在这里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плейлисты появятся здесь, как только часть их песен окажется на этом iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spellistor visas här när några av deras låtar finns på den här iPhonen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As listas aparecem aqui assim que algumas das suas músicas estiverem neste iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As playlists aparecem aqui quando algumas das músicas estão neste iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlisty pojawią się tutaj, gdy część ich utworów znajdzie się na tym iPhonie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲の一部がこのiPhoneにあると、プレイリストがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡 일부가 이 iPhone에 있으면 재생목록이 여기에 표시돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 iPhone 上有其中一些歌曲後，播放列表就會顯示在這裡。"
          }
        }
      }
    },
