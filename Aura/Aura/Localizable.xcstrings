    "Download or stream songs to have them available offline": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda ner eller strömma låtar för att ha dem tillgängliga offline"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfere ou reproduz músicas em streaming para as teres disponíveis offline"
