    "Quick scan checks for new/changed files. Full scan re-reads all metadata.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'escaneig ràpid busca fitxers nous o modificats. L'escaneig complet torna a llegir totes les metadades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schnellscan prüft auf neue oder geänderte Dateien. Der vollständige Scan liest alle Metadaten neu ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis rápido busca archivos nuevos o modificados. El análisis completo vuelve a leer todos los metadatos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse rapide recherche les fichiers nouveaux ou modifiés. L'analyse complète relit toutes les métadonnées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione rapida cerca file nuovi o modificati. La scansione completa rilegge tutti i metadati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De snelle scan controleert op nieuwe of gewijzigde bestanden. De volledige scan leest alle metadata opnieuw in."
          }
        }
      }
    },
