      }
    },
    "The key stays in this iPhone's Keychain.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La clau es queda al clauer d'aquest iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel bleibt im Schlüsselbund dieses iPhones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave se queda en el llavero de este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé reste dans le trousseau de cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave resta nel portachiavi di questo iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel blijft in de sleutelhanger van deze iPhone."
          }
        }
      }
    },
    "The radar follows SoulSync's watchlist, and adds your favourite and most-played artists to it. SoulSync downloads their new releases by itself once a day; Get It fetches one at once.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El radar segueix la llista de seguiment de SoulSync i hi afegeix els teus artistes preferits i els més escoltats. SoulSync baixa les seves novetats tot sol un cop al dia; Get It en recupera una a l'instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Radar folgt der Beobachtungsliste von SoulSync und fügt ihr deine Lieblings- und meistgehörten Interpreten hinzu. SoulSync lädt deren Neuerscheinungen einmal täglich von selbst herunter; Get It holt jeweils eine sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El radar sigue la lista de seguimiento de SoulSync y le añade tus artistas favoritos y más escuchados. SoulSync descarga solo sus novedades una vez al día; Get It consigue una al momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le radar suit la liste de SoulSync et y ajoute vos artistes favoris et les plus écoutés. SoulSync télécharge seul leurs nouveautés une fois par jour ; Get It en récupère une tout de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il radar segue la watchlist di SoulSync e vi aggiunge i tuoi artisti preferiti e più ascoltati. SoulSync scarica da solo le loro nuove uscite una volta al giorno; Get It ne recupera una all'istante."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De radar volgt de volglijst van SoulSync en voegt er je favoriete en meest beluisterde artiesten aan toe. SoulSync downloadt hun nieuwe releases zelf eenmaal per dag; Get It haalt er meteen een op."
          }
        }
      }
    },
    "The server didn't say where the song is.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no ha indicat on és la cançó."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nicht angegeben, wo sich der Titel befindet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no indicó dónde está la canción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas indiqué où se trouve le titre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non ha indicato dove si trova il brano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft niet aangegeven waar het nummer staat."
          }
        }
      }
    },
