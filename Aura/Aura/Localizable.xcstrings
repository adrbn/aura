    "Its songs were removed from this iPhone.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les seves cançons s'han suprimit d'aquest iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Titel wurden von diesem iPhone entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus canciones se eliminaron de este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses titres ont été supprimés de cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi brani sono stati rimossi da questo iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nummers zijn van deze iPhone verwijderd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其歌曲已从这台 iPhone 上移除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его песни удалены с этого iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess låtar togs bort från den här iPhonen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas músicas foram removidas deste iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas foram removidas deste iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego utwory zostały usunięte z tego iPhone’a."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この曲はこのiPhoneから削除されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 곡들이 이 iPhone에서 제거됐어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其歌曲已從這部 iPhone 移除。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho skladby byly z tohoto iPhonu odstraněny."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangene ble fjernet fra denne iPhonen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dens sange blev fjernet fra denne iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen kappaleet poistettiin tästä iPhonesta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Melodiile sale au fost eliminate de pe acest iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Її пісні вилучено з цього iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkıları bu iPhone'dan kaldırıldı."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα τραγούδια του αφαιρέθηκαν από αυτό το iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงในนั้นถูกเอาออกจาก iPhone เครื่องนี้แล้ว"
