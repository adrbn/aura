    "Keep your music for the road, no signal needed.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva la teva música per al viatge, sense necessitat de cobertura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm deine Musik mit auf die Straße, ganz ohne Empfang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva tu música de viaje, sin necesidad de señal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre musique pour la route, sans réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta la tua musica in viaggio, senza bisogno di rete."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je muziek bij de hand onderweg, geen bereik nodig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把音乐带上路，无需信号。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Берите музыку в дорогу — сигнал не нужен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha din musik med dig på vägen, ingen täckning behövs."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva a tua música para a estrada, sem precisares de rede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve sua música na estrada, sem precisar de sinal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miej swoją muzykę na drogę, bez zasięgu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電波がなくても、ドライブに音楽を持ち出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신호가 없어도 음악을 들고 떠나세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將音樂留著上路，無需訊號。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mějte hudbu na cestu, bez signálu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta med musikken på veien, uten behov for dekning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hav din musik med på farten – intet signal nødvendigt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota musiikkisi mukaan matkalle, verkkoa ei tarvita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia-ți muzica la drum, fără semnal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Музика в дорогу без потреби в сигналі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müziğini yol için sakla, sinyal gerekmez."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτα τη μουσική σου για τον δρόμο, χωρίς να χρειάζεται σήμα."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บเพลงไว้ฟังระหว่างเดินทาง ไม่ต้องมีสัญญาณ"
          }
        }
      }
    },
