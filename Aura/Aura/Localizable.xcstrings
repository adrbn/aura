    "Add songs here, or from any song's menu with Add to Playlist.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des morceaux ici, ou depuis le menu de n'importe quel morceau avec Ajouter à une playlist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi brani qui, o dal menu di qualsiasi brano con Aggiungi a playlist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade canciones aquí, o desde el menú de cualquier canción con Añadir a playlist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge hier Titel hinzu oder über das Menü eines Titels mit „Zur Playlist hinzufügen“."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix cançons aquí, o des del menú de qualsevol cançó amb Afegeix a una llista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg hier nummers toe, of via het menu van een nummer met Voeg toe aan afspeellijst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此添加歌曲，或在任意歌曲的菜单中选择“添加到播放列表”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте песни здесь или через меню любой песни: «Добавить в плейлист»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till låtar här, eller från valfri låts meny med Lägg till i spellista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona músicas aqui, ou a partir do menu de qualquer música com Adicionar à lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione músicas aqui ou pelo menu de qualquer música, em Adicionar à playlist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj utwory tutaj lub z menu dowolnego utworu przez Dodaj do playlisty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに曲を追加するか、曲のメニューの「プレイリストに追加」から追加してください。"
