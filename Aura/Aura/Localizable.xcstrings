    "Optional. Sent with every request to this server, for a reverse proxy or a sign-in gateway in front of it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Envoyés avec chaque requête vers ce serveur, pour un reverse proxy ou une passerelle de connexion placée devant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltative. Inviate con ogni richiesta a questo server, per un reverse proxy o un gateway di accesso davanti a esso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Se envían con cada petición a este servidor, para un proxy inverso o una pasarela de acceso delante de él."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Werden mit jeder Anfrage an diesen Server gesendet, für einen Reverse Proxy oder ein Anmelde-Gateway davor."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. S'envien amb cada petició a aquest servidor, per a un proxy invers o una passarel·la d'accés al davant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Meegestuurd met elk verzoek aan deze server, voor een reverse proxy of een inloggateway ervoor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。随每个发往此服务器的请求一起发送，适用于其前面的反向代理或登录网关。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Отправляются с каждым запросом к этому серверу — для обратного прокси или шлюза входа перед ним."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt. Skickas med varje begäran till den här servern, för en omvänd proxy eller en inloggningsgateway framför den."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Enviados com cada pedido a este servidor, para um proxy inverso ou um portal de início de sessão colocado à frente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Enviados em toda solicitação a este servidor, para um proxy reverso ou um gateway de login na frente dele."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie. Wysyłane z każdym żądaniem do tego serwera, dla reverse proxy lub bramki logowania przed nim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。リバースプロキシやサインインゲートウェイがサーバの前にある場合に、このサーバへのすべてのリクエストと一緒に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 이 서버 앞의 리버스 프록시나 로그인 게이트웨이를 위해 모든 요청과 함께 전송돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選填。會隨每個傳送到這個伺服器的要求一併傳送，適用於其前方的反向代理伺服器或登入閘道。"
          }
        }
      }
    },
    "Aura can’t listen to songs in this language yet.": {
      "localizations": {
        "fr": {
