        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline výsledky – jen stažené a uložené skladby"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-resultater – bare nedlastede og bufrede sanger"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Offlineresultater – kun hentede og cachelagrede sange"
          }
        },
        "fi": {
