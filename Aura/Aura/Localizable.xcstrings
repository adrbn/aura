            "state": "translated",
            "value": "Serveren oplyste ikke, hvor sangen er."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ei kertonut, missä kappale on."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul nu a spus unde se află melodia."
          }
        },
        "uk": {
