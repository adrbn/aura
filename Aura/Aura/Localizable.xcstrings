    "\"%@\" already exists. View it or generate a new one?": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ja existeix. Vols veure-la o generar-ne una de nova?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ existiert bereits. Ansehen oder eine neue erstellen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya existe. ¿Quieres verla o generar una nueva?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » existe déjà. L'afficher ou en générer une nouvelle ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" esiste già. Vuoi visualizzarla o generarne una nuova?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" bestaat al. Bekijk 'm of maak een nieuwe aan?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已存在。要查看还是生成新的？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже существует. Открыть или создать новое?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" finns redan. Vill du visa den eller skapa en ny?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" já existe. Queres vê-la ou gerar uma nova?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" já existe. Ver ou gerar uma nova?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” już istnieje. Wyświetlić go czy wygenerować nowy?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はすでに存在します。表示しますか?それとも新しく生成しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"이(가) 이미 있어요. 확인하거나 새로 만들까요?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已存在。要檢視，還是產生新的？"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ už existuje. Zobrazit existující, nebo vytvořit novou?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» finnes allerede. Vil du vise den eller lage en ny?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" findes allerede. Vil du se den eller oprette en ny?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" on jo olemassa. Näytetäänkö se vai luodaanko uusi?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” există deja. O afișezi sau generezi una nouă?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» вже існує. Переглянути чи створити нове?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” zaten var. Görüntülemek mi, yenisini oluşturmak mı istersin?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» υπάρχει ήδη. Θες να το δεις ή να δημιουργήσεις νέο;"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มี \"%@\" อยู่แล้ว ดูหรือสร้างใหม่"
          }
        }
      }
    },
