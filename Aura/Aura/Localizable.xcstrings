    "Download songs, albums, or your entire library.\nListen anywhere without a connection.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa cançons, àlbums o tota la teva biblioteca.\nEscolta on vulguis, sense connexió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Titel, Alben oder deine gesamte Bibliothek herunter.\nHöre überall, auch ohne Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga canciones, álbumes o toda tu biblioteca.\nEscucha donde sea, sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez des titres, des albums ou toute votre bibliothèque.\nÉcoutez partout, sans connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica brani, album o l'intera libreria.\nAscolta ovunque, senza connessione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download nummers, albums of je hele bibliotheek.\nLuister overal, ook zonder verbinding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载歌曲、专辑或整个资料库。\n无需网络，随处聆听。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружайте песни, альбомы или всю медиатеку.\nСлушайте где угодно без подключения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda ner låtar, album eller hela ditt bibliotek.\nLyssna var som helst utan uppkoppling."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfere músicas, álbuns ou toda a tua biblioteca.\nOuve em qualquer lado sem ligação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe músicas, álbuns ou sua biblioteca inteira.\nOuça em qualquer lugar sem conexão."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieraj utwory, albumy lub całą bibliotekę.\nSłuchaj gdziekolwiek bez połączenia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲、アルバム、ライブラリ全体をダウンロード。\n接続なしでどこでも聴けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡, 앨범 또는 보관함 전체를 다운로드하세요.\n연결 없이 어디서나 들을 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載歌曲、專輯或你的整個資料庫。\n隨處聆聽，無需連線。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahuj skladby, alba nebo celou knihovnu.\nPoslouchej kdekoli bez připojení."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last ned sanger, album eller hele biblioteket.\nLytt hvor som helst uten tilkobling."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent sange, albummer eller hele dit bibliotek.\nLyt hvor som helst uden forbindelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa kappaleita, albumeita tai koko kirjastosi.\nKuuntele missä vain ilman yhteyttä."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă melodii, albume sau toată biblioteca.\nAscultă oriunde fără conexiune."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажуйте пісні, альбоми або всю медіатеку.\nСлухайте будь-де без підключення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkıları, albümleri veya tüm arşivini indir.\nBağlantı olmadan her yerde dinle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε λήψη τραγουδιών, άλμπουμ ή όλης της βιβλιοθήκης σου.\nΆκου οπουδήποτε χωρίς σύνδεση."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดเพลง อัลบั้ม หรือทั้งคลังของคุณ\nฟังได้ทุกที่โดยไม่ต้องเชื่อมต่อ"
          }
        }
      }
    },
