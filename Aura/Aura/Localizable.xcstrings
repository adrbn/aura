    "Songs in these genres never play in a mix.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux de ces genres ne passent jamais dans un mix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani di questi generi non entrano mai in un mix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones de estos géneros nunca suenan en una mezcla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs dieser Genres laufen nie in einem Mix."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cançons d'aquests gèneres no sonen mai en una mescla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummers uit deze genres komen nooit in een mix."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些流派的歌曲不会出现在任何混音中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Песни этих жанров никогда не попадают в миксы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låtar i de här genrerna spelas aldrig i en mix."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas destes géneros nunca tocam numa mistura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Músicas destes gêneros nunca tocam em um mix."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory z tych gatunków nigdy nie grają w miksie."
          }
        }
      }
    },
