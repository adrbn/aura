    "Placed %lld of %lld lines by ear, word by word. Play it through, then Save.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lignes sur %2$lld placées à l’oreille, mot à mot. Écoutez jusqu’au bout, puis Enregistrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Zeilen nach Gehör gesetzt, Wort für Wort. Hör es durch, dann Sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld líneas colocadas de oído, palabra por palabra. Escúchala entera y luego Guardar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld righe su %2$lld posizionate a orecchio, parola per parola. Ascoltala tutta, poi Salva."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld línies col·locades d’oïda, paraula per paraula. Escolta-la sencera i després Desa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld van %2$lld regels op gehoor geplaatst, woord voor woord. Luister hem uit en tik dan op Bewaar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已凭听觉逐字放置 %2$lld 行中的 %1$lld 行。完整听一遍，然后存储。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расставлено на слух %1$lld из %2$lld строк, по словам. Дослушайте и нажмите «Сохранить»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Placerade %lld av %lld rader på gehör, ord för ord. Spela igenom den och tryck sedan på Spara."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld linhas colocadas de ouvido, palavra a palavra. Reproduz até ao fim e depois guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld versos posicionados de ouvido, palavra por palavra. Toque a música inteira e depois salve."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawiono ze słuchu %lld z %lld wersów, słowo po słowie. Odtwórz całość, potem Zapisz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld行を耳で聴き取り、単語ごとに配置しました。最後まで再生してから保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld줄을 귀로 듣고 단어별로 맞췄어요. 끝까지 재생한 다음 저장하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已逐字憑聽覺放置 %lld／%lld 行。請完整播放一次，然後儲存。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podle sluchu umístěno %lld z %lld řádků, slovo po slovu. Přehrajte celou skladbu a pak Uložte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasserte %lld av %lld linjer etter gehør, ord for ord. Spill den gjennom, og trykk på Lagre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placerede %lld af %lld linjer efter gehør, ord for ord. Afspil sangen, og tryk derefter på Gem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijoitettiin korvakuulolta %lld/%lld riviä, sana kerrallaan. Kuuntele läpi ja tallenna sitten."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am plasat %lld din %lld rânduri după ureche, cuvânt cu cuvânt. Ascult-o până la capăt, apoi Salvează."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розставлено на слух %lld з %lld рядків, по словах. Прослухайте, потім збережіть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld satır kulakla, kelime kelime yerleştirildi. Sonuna kadar çal, sonra Kaydet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθετήθηκαν %lld από %lld στίχους με το αυτί, λέξη προς λέξη. Παίξ' το ολόκληρο και μετά Αποθήκευση."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วาง %lld จาก %lld บรรทัดด้วยการฟัง ทีละคำ เล่นให้จบ แล้วบันทึก"
          }
        }
      }
    },
    "Heard %lld of %lld lines: they were already in time. Their words are timed now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lignes sur %2$lld entendues : elles étaient déjà en rythme. Leurs mots sont maintenant calés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Zeilen gehört: Sie waren schon im Takt. Ihre Wörter sind jetzt getimt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld líneas oídas: ya iban a tiempo. Ahora sus palabras también."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld righe su %2$lld sentite: erano già a tempo. Ora lo sono anche le parole."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld línies sentides: ja anaven a temps. Ara les paraules també."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld van %2$lld regels gehoord: ze liepen al gelijk. Nu de woorden ook."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已听到 %2$lld 行中的 %1$lld 行：它们本来就同步。现在每个字也已对齐。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Услышано %1$lld из %2$lld строк: они уже совпадали. Теперь совпадают и слова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hörde %lld av %lld rader: de låg redan i takt. Deras ord är nu tajmade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld linhas ouvidas: já estavam sincronizadas. As palavras estão agora sincronizadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld versos ouvidos: já estavam no tempo. As palavras agora estão cronometradas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usłyszano %lld z %lld wersów: były już zsynchronizowane. Ich słowa są teraz zsynchronizowane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld行を聴き取りました。すでにタイミングが合っていたため、単語のタイミングを設定しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld줄을 들었고, 이미 타이밍이 맞아 있었어요. 이제 단어에도 타이밍이 맞춰졌어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽出 %lld／%lld 行：它們原本就已對上時間。現在已逐字標記時間。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slyšeno %lld z %lld řádků: už byly načasované. Jejich slova jsou teď načasovaná."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hørte %lld av %lld linjer: de var allerede i takt. Ordene deres er tidsfestet nå."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hørte %lld af %lld linjer: de var allerede i takt. Deres ord er nu timet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuultiin %lld/%lld riviä: ne olivat jo ajallaan. Niiden sanat on nyt ajoitettu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am auzit %lld din %lld rânduri: erau deja sincronizate. Cuvintele lor sunt acum sincronizate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почуто %lld з %lld рядків: вони вже були синхронні. Тепер їхні слова синхронізовано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld satır duyuldu: zaten zamanındaydılar. Kelimeleri artık zamanlandı."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακούστηκαν %lld από %lld στίχους: ήταν ήδη συγχρονισμένοι. Οι λέξεις τους έχουν τώρα χρονισμό."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้ยิน %lld จาก %lld บรรทัด: ตรงจังหวะอยู่แล้ว ตอนนี้คำต่างๆ ถูกตั้งเวลาแล้ว"
          }
        }
      }
    },
    "Heard %lld of %lld lines. They now come %@ s earlier, word by word.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lignes sur %2$lld entendues. Elles arrivent maintenant %3$@ s plus tôt, mot à mot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Zeilen gehört. Sie kommen jetzt %3$@ s früher, Wort für Wort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld líneas oídas. Ahora llegan %3$@ s antes, palabra por palabra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld righe su %2$lld sentite. Ora arrivano %3$@ s prima, parola per parola."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld línies sentides. Ara arriben %3$@ s abans, paraula per paraula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld van %2$lld regels gehoord. Ze komen nu %3$@ s eerder, woord voor woord."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已听到 %2$lld 行中的 %1$lld 行。现在提前 %3$@ 秒，逐字对齐。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Услышано %1$lld из %2$lld строк. Теперь они идут на %3$@ с раньше, по словам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hörde %lld av %lld rader. De kommer nu %@ s tidigare, ord för ord."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld linhas ouvidas. Agora chegam %@ s mais cedo, palavra a palavra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld versos ouvidos. Agora chegam %@ s antes, palavra por palavra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usłyszano %lld z %lld wersów. Teraz pojawiają się o %@ s wcześniej, słowo po słowie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld行を聴き取りました。単語ごとに%@秒早く表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld줄을 들었어요. 이제 단어별로 %@초 더 일찍 나와요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽出 %lld／%lld 行。它們現在逐字提早 %@ 秒出現。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slyšeno %lld z %lld řádků. Nyní přicházejí o %@ s dříve, slovo po slovu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
