    "Mixes are built from what you listen to. Play a few things first.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els mixos es creen a partir del que escoltes. Primer escolta alguna cosa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixe entstehen aus dem, was du hörst. Hör zuerst ein paar Titel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mixes se crean a partir de lo que escuchas. Escucha algo primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mix sont composés à partir de vos écoutes. Écoutez d'abord quelques titres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I mix nascono da ciò che ascolti. Prima ascolta qualcosa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixen ontstaan uit wat je luistert. Speel eerst een paar nummers af."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "混音根据你的聆听记录生成。先播放一些歌曲吧。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Миксы создаются на основе того, что вы слушаете. Сначала послушайте что-нибудь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixar skapas av det du lyssnar på. Spela några saker först."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As misturas são criadas a partir do que ouves. Ouve primeiro algumas coisas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os mixes são feitos com o que você ouve. Toque algumas coisas primeiro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksy powstają na podstawie tego, czego słuchasz. Najpierw odtwórz kilka rzeczy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミックスは聴いている音楽から作成されます。まずいくつか再生してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "믹스는 듣는 음악을 바탕으로 만들어져요. 먼저 몇 곡을 재생해 보세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "混音是依據你聆聽的內容製作。請先播放一些歌曲。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixy vznikají z toho, co posloucháte. Nejdřív si pár věcí přehrajte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikser lages av det du lytter til. Spill noe først."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mix bygges ud fra det, du lytter til. Afspil lidt musik først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksaukset kootaan kuuntelemastasi musiikista. Toista ensin jotain."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixurile sunt create din ce asculți. Redă mai întâi câteva lucruri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікси створюються з того, що ви слухаєте. Спершу послухайте щось."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksler dinlediklerinden oluşturulur. Önce birkaç şey çal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μιξ φτιάχνονται από όσα ακούς. Παίξε πρώτα μερικά πράγματα."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มิกซ์สร้างจากสิ่งที่คุณฟัง ลองเล่นเพลงสักสองสามเพลงก่อน"
          }
        }
      }
    },
