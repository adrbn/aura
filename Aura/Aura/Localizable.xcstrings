    "\"%@\" already exists. View it or generate a new one?": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ja existeix. Vols veure-la o generar-ne una de nova?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ existiert bereits. Ansehen oder eine neue erstellen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya existe. ¿Quieres verla o generar una nueva?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » existe déjà. L'afficher ou en générer une nouvelle ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" esiste già. Vuoi visualizzarla o generarne una nuova?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" bestaat al. Bekijk 'm of maak een nieuwe aan?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已存在。要查看还是生成新的？"
