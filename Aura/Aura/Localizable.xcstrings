    "Add songs here, or from any song's menu with Add to Playlist.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des morceaux ici, ou depuis le menu de n'importe quel morceau avec Ajouter à une playlist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi brani qui, o dal menu di qualsiasi brano con Aggiungi a playlist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade canciones aquí, o desde el menú de cualquier canción con Añadir a playlist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge hier Titel hinzu oder über das Menü eines Titels mit „Zur Playlist hinzufügen“."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix cançons aquí, o des del menú de qualsevol cançó amb Afegeix a una llista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg hier nummers toe, of via het menu van een nummer met Voeg toe aan afspeellijst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此添加歌曲，或在任意歌曲的菜单中选择“添加到播放列表”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте песни здесь или через меню любой песни: «Добавить в плейлист»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till låtar här, eller från valfri låts meny med Lägg till i spellista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona músicas aqui, ou a partir do menu de qualquer música com Adicionar à lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione músicas aqui ou pelo menu de qualquer música, em Adicionar à playlist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj utwory tutaj lub z menu dowolnego utworu przez Dodaj do playlisty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに曲を追加するか、曲のメニューの「プレイリストに追加」から追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 곡을 추가하거나, 곡 메뉴의 재생목록에 추가로 추가하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡加入歌曲，或從任一首歌曲的選單使用「加入播放列表」。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte skladby sem nebo z nabídky kterékoli skladby přes Přidat do playlistu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til sanger her, eller fra menyen til en sang med Legg til i spilleliste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj sange her eller fra en sangs menu med Føj til spilleliste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kappaleita tästä tai minkä tahansa kappaleen valikosta kohdalla Lisää soittolistaan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă melodii aici sau din meniul oricărei melodii cu Adaugă la playlist."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте пісні тут або з меню будь-якої пісні через «Додати в плейлист»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkıları buradan ya da herhangi bir şarkının menüsünden Çalma Listesine Ekle ile ekle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε τραγούδια εδώ ή από το μενού οποιουδήποτε τραγουδιού με την Προσθήκη σε λίστα."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเพลงที่นี่ หรือจากเมนูของเพลงใดก็ได้ด้วยเพิ่มไปยังเพลย์ลิสต์"
          }
        }
      }
    },
