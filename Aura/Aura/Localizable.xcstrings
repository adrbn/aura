    "ReplayGain turns loud tracks down to a common level, using the tags on your server. Quiet tracks are not boosted.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain redueix les cançons massa fortes a un nivell comú, segons les etiquetes del servidor. Les cançons fluixes no s'amplifiquen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain senkt laute Titel anhand der Tags deines Servers auf ein gemeinsames Niveau. Leise Titel werden nicht verstärkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain baja las canciones demasiado altas a un nivel común, usando las etiquetas de tu servidor. Las canciones bajas no se amplifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain baisse les titres trop forts à un niveau commun, d’après les tags du serveur. Les titres faibles ne sont pas amplifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain abbassa i brani troppo alti a un livello comune, usando i tag del tuo server. I brani deboli non vengono amplificati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain zet te harde nummers terug naar een gemeenschappelijk niveau, op basis van de tags op je server. Zachte nummers worden niet versterkt."
          }
        }
      }
    },
