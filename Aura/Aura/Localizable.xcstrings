    "On Google's free tier, what you send may be used to improve Google's products.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb el pla gratuït de Google, el que envies es pot fer servir per millorar els seus productes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im kostenlosen Google-Tarif kann das Gesendete zur Verbesserung der Google-Produkte verwendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el plan gratuito de Google, lo que envíes puede usarse para mejorar sus productos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec l’offre gratuite de Google, ce que vous envoyez peut servir à améliorer ses produits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il piano gratuito di Google, ciò che invii può essere usato per migliorare i suoi prodotti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het gratis abonnement van Google kan wat je verstuurt worden gebruikt om Googles producten te verbeteren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Google 的免费方案时，你发送的内容可能被用于改进 Google 的产品。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатном тарифе Google отправленные данные могут использоваться для улучшения продуктов Google."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Googles gratisnivå kan det du skickar användas för att förbättra Googles produkter."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No nível gratuito da Google, o que enviares pode ser usado para melhorar os produtos da Google."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No plano gratuito do Google, o que você envia pode ser usado para melhorar os produtos do Google."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W darmowym planie Google to, co wysyłasz, może być używane do ulepszania produktów Google."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleの無料枠では、送信した内容がGoogleの製品の改善に使われることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 무료 등급에서는 전송한 내용이 Google 제품 개선에 사용될 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Google 免費方案時，你傳送的內容可能會用於改善 Google 的產品。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V bezplatném tarifu Google se může to, co odešlete, použít ke zlepšování produktů Google."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På Googles gratisnivå kan det du sender, bli brukt til å forbedre Googles produkter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På Googles gratis niveau kan det, du sender, blive brugt til at forbedre Googles produkter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Googlen ilmaisessa tasossa lähettämääsi sisältöä voidaan käyttää Googlen tuotteiden parantamiseen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În planul gratuit Google, ce trimiți poate fi folosit pentru a îmbunătăți produsele Google."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На безплатному тарифі Google надіслане може використовуватися для покращення продуктів Google."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google'ın ücretsiz katmanında gönderdiklerin Google ürünlerini geliştirmek için kullanılabilir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στη δωρεάν βαθμίδα της Google, ό,τι στέλνεις μπορεί να χρησιμοποιηθεί για τη βελτίωση των προϊόντων της Google."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในแพ็กเกจฟรีของ Google สิ่งที่คุณส่งอาจถูกใช้เพื่อปรับปรุงผลิตภัณฑ์ของ Google"
          }
        }
      }
    },
