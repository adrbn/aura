            "value": "Tryck på översättningsknappen ovanför låttexten för att visa eller dölja översättningen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no botão de tradução por cima da letra para mostrar ou ocultar a tradução."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de tradução acima da letra para mostrar ou ocultar a tradução."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij przycisk tłumaczenia nad tekstem, aby pokazać lub ukryć tłumaczenie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞の上の翻訳ボタンをタップして、翻訳の表示/非表示を切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가사 위의 번역 버튼을 탭하면 번역을 표시하거나 숨길 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
