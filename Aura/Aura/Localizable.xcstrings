    "Pull down to try again.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estira cap avall per tornar-ho a provar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum erneuten Versuch nach unten ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira hacia abajo para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirer vers le bas pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira verso il basso per riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek naar beneden om het opnieuw te proberen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下拉以重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните вниз, чтобы повторить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra nedåt för att försöka igen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxa para baixo para tentar novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe para baixo para tentar de novo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pociągnij w dół, aby spróbować ponownie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下に引いてもう一度試す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래로 당겨서 다시 시도하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向下拉動以再試一次。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetím dolů to zkusíte znovu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra ned for å prøve igjen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk ned for at prøve igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yritä uudelleen vetämällä alas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage în jos pentru a reîncerca."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потягніть униз, щоб спробувати ще."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden denemek için aşağı çek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τράβηξε προς τα κάτω για να δοκιμάσεις ξανά."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงลงเพื่อลองอีกครั้ง"
          }
        }
      }
    },
