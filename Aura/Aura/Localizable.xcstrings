    "Your Mac's language. Songs already in it aren't translated.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'idioma del teu Mac. Les cançons que ja hi són no es tradueixen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache deines Macs. Titel, die bereits in dieser Sprache sind, werden nicht übersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de tu Mac. Las canciones que ya están en ese idioma no se traducen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue de votre Mac. Les chansons déjà dans cette langue ne sont pas traduites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua del tuo Mac. I brani già in questa lingua non vengono tradotti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taal van je Mac. Nummers die daar al in staan, worden niet vertaald."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык вашего Mac. Песни, уже написанные на нем, не переводятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 语言。已是该语言的歌曲不会被翻译。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Macs språk. Låtar som redan är på det översätts inte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma do teu Mac. As músicas que já estão nesse idioma não são traduzidas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma do seu Mac. Músicas que já estão nele não são traduzidas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Język Twojego Maca. Utwory, które już w nim są, nie są tłumaczone."
          }
        }
      }
    },
    "A song translated once is kept on this Mac, and comes back offline.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cançó traduïda una vegada es queda en aquest Mac i torna a aparèixer sense connexió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einmal übersetzter Songtext bleibt auf diesem Mac gespeichert und ist auch offline verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una canción traducida una vez se guarda en este Mac, y vuelve a aparecer sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chanson traduite une fois reste sur ce Mac, même hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
