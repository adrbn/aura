    "New releases from the artists you play most, found in Deezer's public catalogue. Only artist names are sent.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Novetats dels artistes que més escoltes, trobades al catàleg públic de Deezer. Només s'envien els noms dels artistes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuerscheinungen deiner meistgehörten Interpreten, gefunden im öffentlichen Katalog von Deezer. Es werden nur Interpretennamen gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Novedades de los artistas que más escuchas, encontradas en el catálogo público de Deezer. Solo se envían los nombres de los artistas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveautés des artistes que vous écoutez le plus, trouvées dans le catalogue public de Deezer. Seuls les noms d’artistes sont envoyés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove uscite degli artisti che ascolti di più, trovate nel catalogo pubblico di Deezer. Vengono inviati solo i nomi degli artisti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe releases van de artiesten die je het meest beluistert, gevonden in de publieke catalogus van Deezer. Alleen artiestennamen worden verzonden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Deezer 公开曲库中查找你最常听的艺人的新发行。仅发送艺人名称。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новинки артистов, которых вы слушаете чаще всего, из публичного каталога Deezer. Отправляются только имена артистов."
          }
        }
      }
    },
