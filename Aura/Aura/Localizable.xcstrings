    "White labels are hard to read on this colour.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les etiquetes blanques es llegeixen malament amb aquest color."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiße Beschriftungen sind auf dieser Farbe schwer lesbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etiquetas blancas se leen mal con este color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les libellés blancs se lisent mal sur cette couleur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le etichette bianche si leggono male su questo colore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witte labels zijn moeilijk leesbaar op deze kleur."
