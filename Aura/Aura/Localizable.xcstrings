    "Adds the song playing in Aura to your favourites.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix la cançó que sona a l'Aura als teus preferits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt den in Aura laufenden Titel deinen Favoriten hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la canción que suena en Aura a tus favoritos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute le titre en cours dans Aura aux favoris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge il brano in riproduzione in Aura ai preferiti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt het nummer dat in Aura wordt afgespeeld toe aan je favorieten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Aura 中正在播放的歌曲添加到喜爱。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет песню, которая играет в Aura, в избранное."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger till låten som spelas i Aura i dina favoriter."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona aos favoritos a música que está a tocar no Aura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona aos favoritos a música que está tocando no Aura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje utwór odtwarzany w Aura do ulubionych."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Auraで再生中の曲をお気に入りに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura에서 재생 중인 곡을 즐겨찾기에 추가해요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Aura 中正在播放的歌曲加入你的喜好項目。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá skladbu přehrávanou v Aura do oblíbených."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger sangen som spilles i Aura, til i favorittene dine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Føjer sangen, der afspilles i Aura, til dine favoritter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää Aurassa soivan kappaleen suosikkeihisi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă melodia redată în Aura la favorite."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає пісню, що грає в Aura, до улюбленого."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura'da çalan şarkıyı favorilerine ekler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέτει το τραγούδι που παίζει στο Aura στα αγαπημένα σου."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเพลงที่กำลังเล่นใน Aura ไปยังรายการโปรดของคุณ"
          }
        }
      }
    },
