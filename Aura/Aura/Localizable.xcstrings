    "Optional. While this address answers, on your home network, Aura uses it instead of the main one.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Mentre aquesta adreça respongui, a la xarxa de casa, Aura l'utilitza en lloc de la principal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Solange diese Adresse antwortet, verwendet Aura sie im Heimnetzwerk anstelle der Hauptadresse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Mientras esta dirección responda en tu red doméstica, Aura la usará en lugar de la principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Tant que cette adresse répond, sur le réseau de la maison, Aura l’utilise à la place de l’adresse principale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Finché questo indirizzo risponde, sulla tua rete di casa Aura lo usa al posto di quello principale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Zolang dit adres reageert op je thuisnetwerk, gebruikt Aura dit in plaats van het hoofdadres."
          }
        }
      }
    },
