    "Listens to the song on this iPhone and places each line where it is sung": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute le morceau sur cet iPhone et place chaque ligne là où elle est chantée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta il brano su questo iPhone e mette ogni riga dove viene cantata"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha la canción en este iPhone y coloca cada línea donde se canta"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört den Song auf diesem iPhone an und setzt jede Zeile dorthin, wo sie gesungen wird"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolta la cançó en aquest iPhone i col·loca cada línia on es canta"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beluistert het nummer op deze iPhone en zet elke regel waar die gezongen wordt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 iPhone 上聆听歌曲，并把每一行放到演唱的位置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушает песню на этом iPhone и ставит каждую строку туда, где она поётся"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyssnar på låten på den här iPhonen och placerar varje rad där den sjungs"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouve a música neste iPhone e coloca cada linha onde é cantada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouve a música neste iPhone e coloca cada verso onde ele é cantado"
