    "%@ A self-signed certificate will do this — try http:// if the server is on your own network.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Un certificat autosignat ho pot provocar — prova http:// si el servidor és a la teva pròpia xarxa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ein selbstsigniertes Zertifikat kann das verursachen — versuche http://, wenn der Server in deinem eigenen Netzwerk ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Un certificado autofirmado puede causarlo — prueba http:// si el servidor está en tu propia red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Un certificat auto-signé peut en être la cause — essayez http:// si le serveur est sur votre propre réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Può dipendere da un certificato autofirmato — prova http:// se il server è sulla tua rete."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Een zelfondertekend certificaat kan dit veroorzaken — probeer http:// als de server op je eigen netwerk staat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 自签名证书可能导致此问题 — 如果服务器在你自己的网络中，请尝试 http://。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Причиной может быть самоподписанный сертификат — попробуйте http://, если сервер в вашей собственной сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ett självsignerat certifikat ger det här – prova http:// om servern finns på ditt eget nätverk."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Um certificado autoassinado causa isto — experimenta http:// se o servidor estiver na tua própria rede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Um certificado autoassinado causa isso — tente http:// se o servidor estiver na sua própria rede."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tak robi certyfikat z podpisem własnym — spróbuj http://, jeśli serwer jest w Twojej sieci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 自己署名証明書ではこうなります。サーバが自分のネットワーク内にある場合は、http://をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 자체 서명 인증서라면 이렇게 될 수 있어요. 서버가 내 네트워크에 있다면 http://를 사용해 보세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 自行簽署的憑證會造成這種情況，如果伺服器在你自己的網路上，請試試 http://。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tohle udělá certifikát s vlastním podpisem – zkuste http://, pokud je server ve vaší síti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Et selvsignert sertifikat kan gjøre dette – prøv http:// hvis serveren er på ditt eget nettverk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Et selvsigneret certifikat kan give dette – prøv http://, hvis serveren er på dit eget netværk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Itse allekirjoitettu varmenne voi aiheuttaa tämän – kokeile http://-osoitetta, jos palvelin on omassa verkossasi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Un certificat autosemnat poate cauza asta — încearcă http:// dacă serverul e în rețeaua ta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Так буває із самопідписаним сертифікатом — спробуйте http://, якщо сервер у вашій мережі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kendinden imzalı bir sertifika buna yol açabilir — sunucu kendi ağındaysa http:// dene."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Αυτό το προκαλεί ένα αυτοϋπογεγραμμένο πιστοποιητικό — δοκίμασε http:// αν ο διακομιστής είναι στο δικό σου δίκτυο."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใบรับรองที่ลงนามเองจะทำให้เกิดปัญหานี้ — ลองใช้ http:// หากเซิร์ฟเวอร์อยู่ในเครือข่ายของคุณเอง"
          }
        }
      }
    },
