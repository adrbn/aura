          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你 Mac 的語言。已是該語言的歌曲不會翻譯。"
          }
        }
      }
    },
    "A song translated once is kept on this Mac, and comes back offline.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cançó traduïda una vegada es queda en aquest Mac i torna a aparèixer sense connexió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einmal übersetzter Songtext bleibt auf diesem Mac gespeichert und ist auch offline verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una canción traducida una vez se guarda en este Mac, y vuelve a aparecer sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chanson traduite une fois reste sur ce Mac, même hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brano tradotto una volta resta su questo Mac, anche offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nummer dat eenmaal vertaald is, blijft op deze Mac staan en werkt ook offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Однажды переведенная песня сохраняется на этом Mac и доступна офлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲翻译一次后会保留在这台 Mac 上，离线时也能显示。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En låt som översatts en gång sparas på den här Macen och finns kvar offline."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma música traduzida uma vez fica guardada neste Mac e volta a estar disponível sem ligação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma música traduzida uma vez fica salva neste Mac e volta mesmo offline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz przetłumaczony utwór jest zapisywany na tym Macu i wraca także offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度翻訳した曲はこのMacに保存され、オフラインでも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 번역한 곡은 이 Mac에 저장되어 오프라인에서도 볼 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯過一次的歌曲會保留在這部 Mac 上，離線時也能使用。"
          }
        }
      }
    },
    "The key stays in this Mac's Keychain.": {
