    "Tap the translate button above the lyrics to show or hide the translation.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botó de traducció per sobre de la lletra per mostrar o amagar la traducció."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Übersetzungsschaltfläche über dem Songtext, um die Übersetzung ein- oder auszublenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de traducción encima de la letra para mostrar u ocultar la traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher le bouton de traduction au-dessus des paroles pour afficher ou masquer la traduction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante di traduzione sopra il testo per mostrare o nascondere la traduzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de vertaalknop boven de songtekst om de vertaling te tonen of te verbergen."
          }
        }
      }
    },
