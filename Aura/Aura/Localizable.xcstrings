          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der übersetzte Songtext wird an Google gesendet, zusammen mit Titel und Interpret des Songs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se envía a Google la letra que traduces, junto con el título y el artista de la canción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les paroles traduites partent chez Google, avec le titre et l’artiste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
