            "state": "translated",
            "value": "Сервер не вказав, де пісня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu şarkının nerede olduğunu söylemedi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής δεν είπε πού είναι το τραγούδι."
          }
        },
