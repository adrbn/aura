    "Keeping them moves them out of the folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les garder les sort du dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenerle le sposta fuori dalla cartella."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservarlas las saca de la carpeta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten verschiebt sie aus dem Ordner."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar-les les treu de la carpeta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behouden haalt ze uit de map."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留会把它们移出文件夹。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если оставить, они переместятся из папки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du behåller dem flyttas de ut ur mappen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se as mantiveres, saem da pasta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantê-las as tira da pasta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowanie ich przenosi je poza folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残すと、フォルダから移動されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지하면 폴더에서 빠져나와요."
