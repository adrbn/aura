    "A Google account is all it takes: no card, no subscription.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només cal un compte de Google: sense targeta, sense subscripció."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Google-Konto genügt: keine Karte, kein Abo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una cuenta de Google basta: sin tarjeta, sin suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte Google suffit : ni carte, ni abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta un account Google: niente carta, niente abbonamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Google-account is alles wat je nodig hebt: geen kaart, geen abonnement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需一个 Google 账户：无需银行卡，无需订阅。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достаточно аккаунта Google: без карты и без подписки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt som krävs är ett Google-konto: inget kort, ingen prenumeration."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta uma conta Google: sem cartão, sem subscrição."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta uma conta Google: sem cartão, sem assinatura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy konto Google: bez karty, bez subskrypcji."
          }
        }
      }
    },
    "A song translated once is kept on this iPhone, and comes back offline.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cançó traduïda una vegada es queda en aquest iPhone i torna a aparèixer sense connexió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einmal übersetzter Songtext bleibt auf diesem iPhone gespeichert und ist auch offline verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una canción traducida una vez se guarda en este iPhone, y vuelve a aparecer sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chanson traduite une fois reste sur cet iPhone, même hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brano tradotto una volta resta su questo iPhone, anche offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nummer dat eenmaal vertaald is, blijft op deze iPhone staan en werkt ook offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲翻译一次后会保留在这台 iPhone 上，离线时也能显示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Однажды переведенная песня сохраняется на этом iPhone и доступна офлайн."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En låt som översatts en gång sparas på den här iPhonen och finns kvar offline."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma música traduzida uma vez fica guardada neste iPhone e volta a estar disponível sem ligação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma música traduzida uma vez fica salva neste iPhone e volta mesmo offline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz przetłumaczony utwór jest zapisywany na tym iPhonie i wraca także offline."
          }
        }
      }
    },
