    "Keep listening — your top songs, artists, and genres for %@ will appear here as you play music.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueix escoltant — les teves cançons, artistes i gèneres més escoltats de %@ apareixeran aquí a mesura que reprodueixis música."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiterhören — deine meistgehörten Titel, Interpreten und Genres für %@ erscheinen hier, sobald du Musik hörst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue escuchando — tus canciones, artistas y géneros más escuchados de %@ aparecerán aquí a medida que reproduzcas música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres, artistes et genres les plus écoutés de %@ apparaîtront ici au fil des écoutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua ad ascoltare — i tuoi brani, artisti e generi più ascoltati di %@ appariranno qui mentre ascolti musica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf luisteren — je populairste nummers, artiesten en genres voor %@ verschijnen hier naarmate je muziek afspeelt."
          }
        }
      }
    },
