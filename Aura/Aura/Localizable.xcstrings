    "Check your connection or server, then try again.": {
      "comment": "A description for the error view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova la connexió o el servidor i torna-ho a provar."
          }
        },
        "de": {
          "stringUnit": {
