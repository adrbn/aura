    "Once Last.fm has scrobbles in this period, your top songs, artists, and genres show up here.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan Last.fm tingui scrobbles en aquest període, les teves cançons, artistes i gèneres més escoltats apareixeran aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Last.fm Scrobbles für diesen Zeitraum hat, erscheinen hier deine meistgehörten Titel, Interpreten und Genres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cuanto Last.fm tenga scrobbles en este período, tus canciones, artistas y géneros más escuchados aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que Last.fm aura des scrobbles sur cette période, vos titres, artistes et genres les plus écoutés s'afficheront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non appena Last.fm avrà scrobble in questo periodo, i tuoi brani, artisti e generi più ascoltati appariranno qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra Last.fm scrobbles heeft voor deze periode, verschijnen hier je populairste nummers, artiesten en genres."
          }
        }
      }
    },
