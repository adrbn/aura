    "This Device": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest dispositiu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat"
          }
        }
      }
    },
    "This server uses an unencrypted (HTTP) connection — your password and music are sent in the clear. Use HTTPS when possible.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest servidor utilitza una connexió sense xifrar (HTTP): la contrasenya i la música es transmeten sense protecció. Utilitza HTTPS sempre que sigui possible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verwendet eine unverschlüsselte (HTTP) Verbindung — dein Passwort und deine Musik werden im Klartext gesendet. Verwende nach Möglichkeit HTTPS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa una conexión sin cifrar (HTTP): tu contraseña y tu música viajan sin protección. Usa HTTPS siempre que puedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur utilise une connexion non chiffrée (HTTP) : le mot de passe et la musique circulent en clair. Privilégier le HTTPS si possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server utilizza una connessione non crittografata (HTTP): la password e la musica vengono inviate in chiaro. Usa HTTPS quando possibile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server gebruikt een onversleutelde (HTTP) verbinding — je wachtwoord en muziek worden onversleuteld verzonden. Gebruik indien mogelijk HTTPS."
          }
        }
      }
    },
    "This will permanently delete the selected playlists from the server. You can undo this briefly after deletion.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això suprimirà definitivament les playlists seleccionades del servidor. Podràs desfer-ho poc després de la supressió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die ausgewählten Playlists endgültig vom Server gelöscht. Du kannst dies kurz nach dem Löschen rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente las listas seleccionadas del servidor. Puedes deshacerlo brevemente después de la eliminación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les playlists sélectionnées seront définitivement supprimées du serveur. L'opération pourra être annulée brièvement après la suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le playlist selezionate verranno eliminate definitivamente dal server. Potrai annullare l'operazione per un breve periodo dopo l'eliminazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de geselecteerde playlists definitief van de server verwijderd. Dit kan kort na het verwijderen nog ongedaan worden gemaakt."
          }
        }
      }
    },
    "This will permanently remove all %lld downloaded songs from your device.": {
      "comment": "A confirmation dialog message that appears when the user deletes all their downloaded songs.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això suprimirà definitivament les %lld cançons baixades d'aquest dispositiu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle %lld heruntergeladenen Titel endgültig von deinem Gerät entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente las %lld canciones descargadas de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld titres téléchargés seront définitivement supprimés de cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i %lld brani scaricati verranno rimossi definitivamente da questo dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle %lld gedownloade nummers definitief van je apparaat verwijderd."
          }
        }
      }
    },
