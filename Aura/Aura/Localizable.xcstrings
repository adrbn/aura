    "Mixes are made again every eight hours, and when the time of day changes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mix sont recréés toutes les huit heures, et quand le moment de la journée change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I mix vengono ricreati ogni otto ore e quando cambia il momento della giornata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mezclas se rehacen cada ocho horas y cuando cambia el momento del día."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixe werden alle acht Stunden neu erstellt und wenn sich die Tageszeit ändert."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mescles es tornen a fer cada vuit hores i quan canvia el moment del dia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixen worden elke acht uur opnieuw gemaakt, en wanneer het moment van de dag verandert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "混音每八小时重新生成一次，时段变化时也会重新生成。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Миксы создаются заново каждые восемь часов и при смене времени суток."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixar skapas på nytt var åttonde timme och när tiden på dagen ändras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As misturas são criadas de novo de oito em oito horas, e quando a hora do dia muda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os mixes são refeitos a cada oito horas e quando a hora do dia muda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksy są tworzone ponownie co osiem godzin i przy zmianie pory dnia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミックスは8時間ごとと、時間帯が変わるときに作り直されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "믹스는 여덟 시간마다, 그리고 시간대가 바뀔 때 다시 만들어져요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "混音每八小時重新製作一次，時段改變時也會重新製作。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixy se vytvářejí znovu každých osm hodin a při změně denní doby."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikser lages på nytt hver åttende time og når tiden på døgnet endres."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mix laves igen hver ottende time, og når tidspunktet på dagen skifter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksaukset tehdään uudelleen kahdeksan tunnin välein ja kun vuorokaudenaika vaihtuu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixurile sunt create din nou la fiecare opt ore și când se schimbă momentul zilei."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікси створюються знову кожні вісім годин і коли змінюється час доби."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksler sekiz saatte bir ve günün saati değiştiğinde yeniden yapılır."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μιξ φτιάχνονται ξανά κάθε οκτώ ώρες και όταν αλλάζει η ώρα της ημέρας."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มิกซ์จะถูกสร้างใหม่ทุกแปดชั่วโมง และเมื่อช่วงเวลาของวันเปลี่ยน"
          }
        }
      }
    },
