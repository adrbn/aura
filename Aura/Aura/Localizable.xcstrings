    "Streamed songs are cached automatically and may be cleared by iOS when storage is low. Downloads are permanent.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Strömmade låtar cachas automatiskt och kan rensas av iOS när lagringsutrymmet är lågt. Nedladdningar är permanenta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas em streaming são guardadas em cache automaticamente e podem ser apagadas pelo iOS quando o armazenamento está quase cheio. As transferências são permanentes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Músicas transmitidas ficam em cache automaticamente e o iOS pode limpá-las quando o armazenamento está baixo. Os downloads são permanentes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory ze streamingu są zapisywane automatycznie i iOS może je usunąć, gdy brakuje miejsca. Pobrane utwory pozostają na stałe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミングした曲は自動でキャッシュされ、ストレージの空きが少ないとiOSに消去されることがあります。ダウンロードした曲は永続的に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍한 곡은 자동으로 캐시되며, 저장 공간이 부족하면 iOS에서 지울 수 있어요. 다운로드한 곡은 영구적으로 유지돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "串流的歌曲會自動快取，儲存空間不足時 iOS 可能會將其清除。下載的項目會永久保留。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamované skladby se ukládají automaticky a iOS je může smazat, když dochází místo. Stažené zůstávají trvale."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strømmede sanger bufres automatisk og kan bli fjernet av iOS når det er lite lagringsplass. Nedlastinger er permanente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamede sange cachelagres automatisk og kan blive ryddet af iOS, når der er lidt lagerplads. Overførsler er permanente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suoratoistetut kappaleet tallentuvat välimuistiin automaattisesti, ja iOS voi tyhjentää ne, kun tallennustila on vähissä. Lataukset ovat pysyviä."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Melodiile redate în streaming sunt puse automat în cache și pot fi șterse de iOS când spațiul este redus. Descărcările sunt permanente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пісні, що слухаються потоково, кешуються автоматично, і iOS може видалити їх, коли бракує місця. Завантаження зберігаються назавжди."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akışla dinlenen şarkılar otomatik olarak önbelleğe alınır ve alan azaldığında iOS tarafından silinebilir. İndirilenler kalıcıdır."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα τραγούδια σε ροή αποθηκεύονται αυτόματα στην κρυφή μνήμη και το iOS μπορεί να τα διαγράψει όταν ο χώρος είναι λίγος. Οι λήψεις είναι μόνιμες."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงที่สตรีมจะถูกแคชอัตโนมัติและ iOS อาจล้างออกเมื่อพื้นที่เหลือน้อย รายการดาวน์โหลดจะอยู่ถาวร"
          }
        }
      }
    },
    "Streams original files (FLAC/ALAC). Uses more data. Incompatible formats (OGG/Opus) are auto-transcoded.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprodueix en continu els fitxers originals (FLAC/ALAC). Consumeix més dades. Els formats incompatibles (OGG/Opus) es transcodifiquen automàticament."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamt die Originaldateien (FLAC/ALAC). Verbraucht mehr Datenvolumen. Inkompatible Formate (OGG/Opus) werden automatisch umgewandelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce los archivos originales (FLAC/ALAC). Usa más datos. Los formatos incompatibles (OGG/Opus) se transcodifican automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffuse les fichiers d'origine (FLAC/ALAC). Consomme plus de données. Les formats incompatibles (OGG/Opus) sont transcodés automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasmette i file originali (FLAC/ALAC). Consuma più dati. I formati incompatibili (OGG/Opus) vengono transcodificati automaticamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamt de originele bestanden (FLAC/ALAC). Verbruikt meer data. Incompatibele formaten (OGG/Opus) worden automatisch getranscodeerd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串流原始文件（FLAC/ALAC），会消耗更多数据。不兼容的格式（OGG/Opus）会自动转码。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизведение исходных файлов (FLAC/ALAC). Расходует больше трафика. Несовместимые форматы (OGG/Opus) перекодируются автоматически."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Strömmar originalfiler (FLAC/ALAC). Använder mer data. Format som inte stöds (OGG/Opus) kodas om automatiskt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz os ficheiros originais (FLAC/ALAC). Usa mais dados. Os formatos incompatíveis (OGG/Opus) são convertidos automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmite os arquivos originais (FLAC/ALAC). Usa mais dados. Formatos incompatíveis (OGG/Opus) são transcodificados automaticamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamuje pliki oryginalne (FLAC/ALAC). Zużywa więcej danych. Niezgodne formaty (OGG/Opus) są transkodowane automatycznie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナルファイル(FLAC/ALAC)をストリーミングします。通信量が多くなります。非対応の形式(OGG/Opus)は自動でトランスコードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일(FLAC/ALAC)을 스트리밍해요. 데이터를 더 많이 사용해요. 호환되지 않는 형식(OGG/Opus)은 자동으로 변환돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "串流原始檔案（FLAC/ALAC）。會使用較多數據。不相容的格式（OGG/Opus）會自動轉碼。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamuje původní soubory (FLAC/ALAC). Spotřebuje víc dat. Nekompatibilní formáty (OGG/Opus) se překódují automaticky."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strømmer originalfiler (FLAC/ALAC). Bruker mer data. Inkompatible formater (OGG/Opus) omkodes automatisk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamer originalfiler (FLAC/ALAC). Bruger mere data. Ikke-kompatible formater (OGG/Opus) omkodes automatisk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suoratoistaa alkuperäiset tiedostot (FLAC/ALAC). Käyttää enemmän dataa. Yhteensopimattomat muodot (OGG/Opus) transkoodataan automaattisesti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redă fișierele originale (FLAC/ALAC). Folosește mai multe date. Formatele incompatibile (OGG/Opus) sunt transcodate automat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передає оригінальні файли (FLAC/ALAC). Використовує більше даних. Несумісні формати (OGG/Opus) перекодовуються автоматично."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal dosyaları (FLAC/ALAC) akışla çalar. Daha çok veri kullanır. Uyumsuz biçimler (OGG/Opus) otomatik dönüştürülür."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ροή αρχικών αρχείων (FLAC/ALAC). Χρησιμοποιεί περισσότερα δεδομένα. Μη συμβατές μορφές (OGG/Opus) μετατρέπονται αυτόματα."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สตรีมไฟล์ต้นฉบับ (FLAC/ALAC) ใช้ข้อมูลมากขึ้น รูปแบบที่ไม่รองรับ (OGG/Opus) จะถูกแปลงอัตโนมัติ"
          }
        }
      }
    },
