          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på översättningsknappen bredvid låttexten för att visa eller dölja översättningen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clica no botão de tradução junto à letra para mostrar ou ocultar a tradução."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no botão de tradução ao lado da letra para mostrar ou ocultar a tradução."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
