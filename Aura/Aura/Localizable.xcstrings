    "Download songs, albums, or your entire library.\nListen anywhere without a connection.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa cançons, àlbums o tota la teva biblioteca.\nEscolta on vulguis, sense connexió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Titel, Alben oder deine gesamte Bibliothek herunter.\nHöre überall, auch ohne Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga canciones, álbumes o toda tu biblioteca.\nEscucha donde sea, sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez des titres, des albums ou toute votre bibliothèque.\nÉcoutez partout, sans connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica brani, album o l'intera libreria.\nAscolta ovunque, senza connessione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download nummers, albums of je hele bibliotheek.\nLuister overal, ook zonder verbinding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载歌曲、专辑或整个资料库。\n无需网络，随处聆听。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружайте песни, альбомы или всю медиатеку.\nСлушайте где угодно без подключения."
          }
        }
      }
    },
