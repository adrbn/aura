    "Their coffees keep Aura going.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els seus cafès fan que Aura continuï."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejich káva drží Auru v chodu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deres kaffe holder Aura i gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Kaffees halten Aura am Laufen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καφέδες τους κρατούν το Aura ζωντανό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus cafés mantienen Aura en marcha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Heidän kahvinsa pitävät Auran käynnissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leurs cafés font vivre Aura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I loro caffè mandano avanti Aura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "皆さんのコーヒーがAuraを支えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이분들의 커피가 Aura를 계속 움직이게 해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaffen deres holder Aura i gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hun koffie houdt Aura draaiende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kawa pozwala Aurze działać dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cafés deles mantêm o Aura vivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cafés deles mantêm o Aura vivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafelele lor țin Aura în viață."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их кофе помогает Aura жить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Deras kaffe håller Aura igång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กาแฟจากพวกเขาทำให้ Aura ไปต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
