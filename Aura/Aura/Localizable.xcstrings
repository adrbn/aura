    "Download music on your iPhone to play it here without a connection": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa música a l'iPhone per escoltar-la aquí sense connexió"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Musik auf dein iPhone, um sie hier ohne Verbindung zu hören"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga música en tu iPhone para escucharla aquí sin conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez de la musique sur votre iPhone pour l'écouter ici sans connexion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica musica sull'iPhone per ascoltarla qui senza connessione"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download muziek op je iPhone om die hier zonder verbinding te luisteren"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上下载音乐，即可在这里离线播放"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите музыку на iPhone, чтобы слушать ее здесь без подключения"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda ner musik på din iPhone för att spela den här utan uppkoppling"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfere música no teu iPhone para a ouvires aqui sem ligação"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe músicas no seu iPhone para ouvi-las aqui sem conexão"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz muzykę na iPhone’a, aby odtwarzać ją tutaj bez połączenia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneに音楽をダウンロードすると、接続なしでここで再生できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에 음악을 다운로드하면 연결 없이도 여기서 재생할 수 있어요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上下載音樂，即可在無網路連線時於此播放"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhni hudbu do iPhonu a přehrávej ji tady bez připojení"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last ned musikk på iPhonen for å spille den her uten tilkobling"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent musik på din iPhone for at afspille den her uden forbindelse"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa musiikkia iPhonellesi, niin voit toistaa sitä täällä ilman yhteyttä"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă muzică pe iPhone pentru a o reda aici fără conexiune"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажте музику на iPhone, щоб слухати її тут без підключення"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada bağlantısız çalmak için müziği iPhone'una indir"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε λήψη μουσικής στο iPhone σου για να την παίζεις εδώ χωρίς σύνδεση"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดเพลงบน iPhone ของคุณเพื่อเล่นที่นี่โดยไม่ต้องเชื่อมต่อ"
          }
        }
      }
    },
    "No connection — your downloads are in Downloaded": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense connexió — les teves baixades són a Baixat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung — deine Downloads findest du unter Heruntergeladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión — tus descargas están en Descargado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion — vos téléchargements sont dans Téléchargé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione — i tuoi download sono in Scaricato"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen verbinding — je downloads staan onder Gedownload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无网络连接 — 你的下载内容在“已下载”中"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения — ваши загрузки в разделе «Загружено»"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen anslutning – dina nedladdningar finns under Nedladdat"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ligação — as tuas transferências estão em Transferidas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão — seus downloads estão em Baixadas"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia — Twoje pobrane utwory są w Pobranych"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続なし — ダウンロードはダウンロード済みにあります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 없음 — 다운로드한 곡은 다운로드됨에 있어요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無網路連線，你的下載項目在「已下載」中"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné připojení – stažené skladby najdeš ve Stažených"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tilkobling – nedlastingene dine er i Lastet ned"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen forbindelse – dine overførsler ligger under Hentet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei yhteyttä – lataukset löytyvät kohdasta Ladatut"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără conexiune — descărcările tale sunt în Descărcate"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає підключення — ваші завантаження в «Завантажено»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yok — indirdiklerin İndirilenler'de"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς σύνδεση — οι λήψεις σου είναι στα Ληφθέντα"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการเชื่อมต่อ — รายการดาวน์โหลดของคุณอยู่ในดาวน์โหลดแล้ว"
