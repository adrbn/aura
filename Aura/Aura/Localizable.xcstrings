    "Long-press the cover art on the playlist page to change it from your photo library.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A la pàgina de la playlist, mantén premuda la portada per canviar-la des de la teva fototeca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
