    "Download songs while you're online, and they'll be here.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa cançons quan estiguis en línia i apareixeran aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Titel herunter, während du online bist — sie erscheinen dann hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga canciones cuando tengas conexión y aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez des titres quand vous êtes en ligne : ils apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica brani mentre sei online: appariranno qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download nummers terwijl je online bent, dan verschijnen ze hier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线时下载歌曲，它们就会出现在这里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружайте песни, пока вы онлайн, и они появятся здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda ner låtar medan du är online så finns de här."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfere músicas enquanto estás online e ficam aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe músicas enquanto estiver online e elas ficarão aqui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieraj utwory, gdy jesteś online, a pojawią się tutaj."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインのうちに曲をダウンロードすると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인일 때 곡을 다운로드하면 여기에 표시돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在連線時下載歌曲，它們就會顯示在這裡。"
          }
        }
      }
    },
    "Download songs, albums or playlists while you're online, and they'll be here.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa cançons, àlbums o playlists quan estiguis en línia i apareixeran aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Titel, Alben oder Playlists herunter, während du online bist — sie erscheinen dann hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga canciones, álbumes o listas cuando tengas conexión y aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez des titres, albums ou playlists quand vous êtes en ligne : ils apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica brani, album o playlist mentre sei online: appariranno qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download nummers, albums of playlists terwijl je online bent, dan verschijnen ze hier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线时下载歌曲、专辑或播放列表，它们就会出现在这里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружайте песни, альбомы или плейлисты, пока вы онлайн, и они появятся здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda ner låtar, album eller spellistor medan du är online så finns de här."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfere músicas, álbuns ou listas enquanto estás online e ficam aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe músicas, álbuns ou playlists enquanto estiver online e eles ficarão aqui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieraj utwory, albumy lub playlisty, gdy jesteś online, a pojawią się tutaj."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインのうちに曲、アルバム、プレイリストをダウンロードすると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인일 때 곡, 앨범 또는 재생목록을 다운로드하면 여기에 표시돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在連線時下載歌曲、專輯或播放列表，它們就會顯示在這裡。"
          }
        }
      }
    },
    "Downloaded, but your server hasn't added it yet": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixada, però el servidor encara no l'ha afegit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladen, aber dein Server hat es noch nicht hinzugefügt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargada, pero tu servidor aún no la ha añadido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargé, mais pas encore ajouté par le serveur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaricato, ma non ancora aggiunto dal server"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedownload, maar nog niet toegevoegd door je server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载，但服务器尚未添加"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружено, но сервер еще не добавил это"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedladdad, men din server har inte lagt till den än"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferida, mas o teu servidor ainda não a adicionou"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixada, mas seu servidor ainda não a adicionou"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrano, ale Twój serwer jeszcze go nie dodał"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード済みですが、サーバにはまだ追加されていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드했지만 서버에는 아직 추가되지 않았어요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已下載，但你的伺服器尚未加入"
          }
        }
      }
    },
    "Downloads stay until you remove them. Streamed songs are kept too, but iOS may clear them when storage runs low.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les baixades es queden fins que les suprimeixis. Les cançons escoltades en streaming també es guarden, però iOS les pot esborrar si l'espai s'esgota."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads bleiben, bis du sie entfernst. Gestreamte Titel werden ebenfalls behalten, aber iOS kann sie bei knappem Speicher löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas permanecen hasta que las quites. Las canciones reproducidas en streaming también se guardan, pero iOS puede borrarlas si falta espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements restent jusqu’à leur suppression. Les titres écoutés en streaming sont aussi gardés, mais iOS peut les effacer si le stockage manque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download restano finché non li rimuovi. Anche i brani riprodotti in streaming vengono conservati, ma iOS potrebbe eliminarli se lo spazio di archiviazione scarseggia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads blijven staan tot je ze verwijdert. Gestreamde nummers worden ook bewaard, maar iOS kan ze wissen als de opslag bijna vol is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载内容会一直保留，直到你移除。串流过的歌曲也会保留，但储存空间不足时 iOS 可能会清除它们。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки хранятся, пока вы их не удалите. Песни из стриминга тоже сохраняются, но iOS может удалить их, когда заканчивается место."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedladdningar finns kvar tills du tar bort dem. Strömmade låtar sparas också, men iOS kan rensa dem när lagringsutrymmet tar slut."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As transferências ficam até as removeres. As músicas em streaming também são guardadas, mas o iOS pode apagá-las quando o armazenamento estiver quase cheio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os downloads ficam até você removê-los. Músicas transmitidas também são guardadas, mas o iOS pode limpá-las quando o armazenamento estiver baixo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrane utwory zostają, dopóki ich nie usuniesz. Utwory ze streamingu też są zachowywane, ale iOS może je usunąć, gdy brakuje miejsca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードは削除するまで残ります。ストリーミングした曲も保持されますが、ストレージの空きが少なくなるとiOSに消去されることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 곡은 제거할 때까지 유지돼요. 스트리밍한 곡도 보관되지만 저장 공간이 부족하면 iOS에서 지울 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載項目會保留到你將其移除為止。串流的歌曲也會保留，但儲存空間不足時 iOS 可能會將其清除。"
          }
        }
      }
    },
