    "Nothing answered at %@. Check the address and the port, and that you're on the right network or VPN.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Res no ha respost a %@. Comprova l'adreça i el port, i que ets a la xarxa o VPN correcta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter %@ hat nichts geantwortet. Prüfe Adresse und Port und ob du im richtigen Netzwerk oder VPN bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada respondió en %@. Revisa la dirección y el puerto, y que estás en la red o VPN correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a répondu à %@. Vérifiez l'adresse et le port, et que vous êtes sur le bon réseau ou VPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna risposta da %@. Controlla l'indirizzo e la porta, e di essere sulla rete o VPN giusta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets reageerde op %@. Controleer het adres en de poort, en of je op het juiste netwerk of VPN zit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有响应。请检查地址和端口，并确认你连接的是正确的网络或 VPN。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По адресу %@ ничего не ответило. Проверьте адрес и порт, а также что вы в нужной сети или VPN."
          }
        }
      }
    },
