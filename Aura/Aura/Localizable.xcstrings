            "state": "translated",
            "value": "Het bestand van het nummer is niet gevonden via File Browser."
          }
        }
      }
    },
    "Their new releases come back to the radar at its next daily pass.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les seves novetats tornen al radar en el pròxim pas diari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Neuerscheinungen erscheinen beim nächsten täglichen Durchlauf wieder im Radar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus novedades volverán al radar en su próximo paso diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses nouveautés reviennent sur le radar à son prochain passage quotidien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le loro nuove uscite tornano sul radar al prossimo passaggio giornaliero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hun nieuwe releases verschijnen weer op de radar bij de volgende dagelijkse ronde."
          }
        }
      }
    },
