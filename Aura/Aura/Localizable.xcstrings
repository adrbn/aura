    "slskd refused the sign-in — check the username and password in Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "slskd a refusé la connexion — vérifier l'identifiant et le mot de passe dans Réglages"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "slskd hat die Anmeldung abgelehnt — Benutzername und Passwort in den Einstellungen prüfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "slskd rechazó el inicio de sesión — revisa el usuario y la contraseña en Ajustes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "slskd ha rifiutato l'accesso — controlla nome utente e password nelle Impostazioni"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "slskd ha rebutjat l'inici de sessió — comprova l'usuari i la contrasenya a Configuració"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "slskd weigerde de aanmelding — controleer gebruikersnaam en wachtwoord in Instellingen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "slskd 拒绝登录 — 请在“设置”中检查用户名和密码"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "slskd отклонил вход — проверьте имя пользователя и пароль в Настройках"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "slskd nekade inloggningen – kontrollera användarnamn och lösenord i Inställningar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O slskd recusou o início de sessão — verifica o nome de utilizador e a palavra-passe nas Definições"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O slskd recusou o login — confira o usuário e a senha nos Ajustes"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "slskd odrzucił logowanie — sprawdź nazwę użytkownika i hasło w Ustawieniach"
