    "A Google account is all it takes: no card, no subscription.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només cal un compte de Google: sense targeta, sense subscripció."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Google-Konto genügt: keine Karte, kein Abo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una cuenta de Google basta: sin tarjeta, sin suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte Google suffit : ni carte, ni abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta un account Google: niente carta, niente abbonamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Google-account is alles wat je nodig hebt: geen kaart, geen abonnement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需一个 Google 账户：无需银行卡，无需订阅。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достаточно аккаунта Google: без карты и без подписки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt som krävs är ett Google-konto: inget kort, ingen prenumeration."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta uma conta Google: sem cartão, sem subscrição."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta uma conta Google: sem cartão, sem assinatura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy konto Google: bez karty, bez subskrypcji."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なのはGoogleアカウントだけ。カードもサブスクリプションも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 계정만 있으면 돼요. 카드도, 구독도 필요 없어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需要一個 Google 帳號：不用信用卡，不用訂閱。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stačí účet Google: bez karty, bez předplatného."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du trenger er en Google-konto: ikke kort, ikke abonnement."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En Google-konto er alt, der skal til: intet kort, intet abonnement."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitset vain Google-tilin: ei korttia, ei tilausta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai nevoie doar de un cont Google: fără card, fără abonament."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен лише обліковий запис Google: без картки, без підписки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Google hesabı yeterli: kart yok, abonelik yok."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αρκεί ένας λογαριασμός Google: χωρίς κάρτα, χωρίς συνδρομή."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แค่มีบัญชี Google ก็พอ: ไม่ต้องใช้บัตร ไม่ต้องสมัครสมาชิก"
          }
        }
      }
    },
    "A song translated once is kept on this iPhone, and comes back offline.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cançó traduïda una vegada es queda en aquest iPhone i torna a aparèixer sense connexió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einmal übersetzter Songtext bleibt auf diesem iPhone gespeichert und ist auch offline verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una canción traducida una vez se guarda en este iPhone, y vuelve a aparecer sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chanson traduite une fois reste sur cet iPhone, même hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brano tradotto una volta resta su questo iPhone, anche offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nummer dat eenmaal vertaald is, blijft op deze iPhone staan en werkt ook offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲翻译一次后会保留在这台 iPhone 上，离线时也能显示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Однажды переведенная песня сохраняется на этом iPhone и доступна офлайн."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En låt som översatts en gång sparas på den här iPhonen och finns kvar offline."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma música traduzida uma vez fica guardada neste iPhone e volta a estar disponível sem ligação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma música traduzida uma vez fica salva neste iPhone e volta mesmo offline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz przetłumaczony utwór jest zapisywany na tym iPhonie i wraca także offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度翻訳した曲はこのiPhoneに保存され、オフラインでも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 번역한 곡은 이 iPhone에 저장되어 오프라인에서도 볼 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯過一次的歌曲會保留在這部 iPhone 上，離線時也能使用。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednou přeložená skladba se uloží do tohoto iPhonu a funguje i offline."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En sang som er oversatt én gang, beholdes på denne iPhonen og er tilgjengelig offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En sang, der er oversat én gang, gemmes på denne iPhone og er også tilgængelig offline."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerran käännetty kappale säilyy tässä iPhonessa ja on käytettävissä myös offline-tilassa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O melodie tradusă o dată rămâne pe acest iPhone și revine și offline."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекладена пісня зберігається на цьому iPhone і доступна офлайн."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez çevrilen şarkı bu iPhone'da saklanır ve çevrimdışıyken de gelir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα τραγούδι που μεταφράστηκε μία φορά μένει σε αυτό το iPhone και επανέρχεται εκτός σύνδεσης."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงที่แปลแล้วครั้งหนึ่งจะเก็บไว้ใน iPhone เครื่องนี้ และกลับมาได้แม้ออฟไลน์"
          }
        }
      }
    },
