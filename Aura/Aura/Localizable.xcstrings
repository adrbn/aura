    "The time of day mix follows the hour: morning, afternoon, evening or late night.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mix du moment suit l'heure : matin, après-midi, soir ou nuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mix del momento segue l'ora: mattina, pomeriggio, sera o notte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mezcla del momento sigue la hora: mañana, tarde, noche o madrugada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tageszeit-Mix folgt der Uhrzeit: Morgen, Nachmittag, Abend oder Nacht."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La mescla del moment segueix l'hora: matí, tarda, vespre o nit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mix van het moment volgt het uur: ochtend, middag, avond of nacht."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时段混音随时间变化：早晨、下午、傍晚或深夜。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микс по времени суток зависит от часа: утро, день, вечер или ночь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixen efter tid på dagen följer klockan: morgon, eftermiddag, kväll eller sen natt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mistura da hora do dia segue a hora: manhã, tarde, noite ou fim de noite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mix da hora do dia segue o horário: manhã, tarde, noite ou madrugada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miks pory dnia zmienia się z godziną: poranek, popołudnie, wieczór lub późna noc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間帯ミックスは時刻に応じて、朝、午後、夜、深夜に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간대 믹스는 시간에 따라 아침, 오후, 저녁, 심야로 바뀌어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時段混音會依照時間而定：早上、下午、傍晚或深夜。"
          }
