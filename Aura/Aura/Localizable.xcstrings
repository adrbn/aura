    "Tap another server to switch to it. Swipe left to remove. When the one in use stops answering, Aura can move to the next one that does.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un autre serveur pour y passer. Balayez vers la gauche pour le retirer. Quand celui utilisé ne répond plus, Aura peut passer au suivant qui répond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un altro server per passarci. Scorri a sinistra per rimuoverlo. Quando quello in uso non risponde più, Aura può passare al successivo che risponde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca otro servidor para cambiar a él. Desliza a la izquierda para quitarlo. Cuando el que usas deja de responder, Aura puede pasar al siguiente que responda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen anderen Server, um zu wechseln. Nach links wischen zum Entfernen. Antwortet der aktive nicht mehr, kann Aura zum nächsten wechseln, der antwortet."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un altre servidor per canviar-hi. Llisca a l'esquerra per treure'l. Quan el que fas servir deixa de respondre, Aura pot passar al següent que respongui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een andere server om te wisselen. Veeg naar links om te verwijderen. Reageert de huidige niet meer, dan kan Aura naar de volgende die wel reageert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点其他服务器即可切换。向左轻扫可移除。当前服务器无响应时，Aura 可切换到下一个有响应的服务器。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на другой сервер, чтобы переключиться. Смахните влево, чтобы удалить. Если текущий перестал отвечать, Aura может перейти на следующий отвечающий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en annan server för att byta till den. Svep åt vänster för att ta bort. När den som används slutar svara kan Aura gå över till nästa som svarar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca noutro servidor para mudar para ele. Desliza para a esquerda para remover. Quando o que está a ser usado deixar de responder, o Aura pode passar para o seguinte que responda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em outro servidor para alternar para ele. Deslize para a esquerda para remover. Quando o servidor em uso parar de responder, o Aura pode passar para o próximo que responder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij inny serwer, aby się na niego przełączyć. Przesuń w lewo, aby usunąć. Gdy używany serwer przestanie odpowiadać, Aura może przejść do następnego, który odpowiada."
          }
        }
      }
    },
