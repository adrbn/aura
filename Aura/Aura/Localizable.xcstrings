          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线结果 — 仅限已下载和已缓存的歌曲"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн-результаты — только загруженные и кэшированные песни"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Offlineresultat – bara nedladdade och cachade låtar"
          }
        },
        "pt-PT": {
