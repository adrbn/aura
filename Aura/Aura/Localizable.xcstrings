    "Mixes are made again every eight hours, and when the time of day changes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mix sont recréés toutes les huit heures, et quand le moment de la journée change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I mix vengono ricreati ogni otto ore e quando cambia il momento della giornata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mezclas se rehacen cada ocho horas y cuando cambia el momento del día."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixe werden alle acht Stunden neu erstellt und wenn sich die Tageszeit ändert."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mescles es tornen a fer cada vuit hores i quan canvia el moment del dia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixen worden elke acht uur opnieuw gemaakt, en wanneer het moment van de dag verandert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "混音每八小时重新生成一次，时段变化时也会重新生成。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Миксы создаются заново каждые восемь часов и при смене времени суток."
          }
        }
      }
    },
