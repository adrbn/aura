    "The address answered with something Aura couldn't read. It may be a different app, or a reverse proxy sitting in front of the wrong service.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adreça ha respost amb alguna cosa que Aura no pot llegir. Pot ser una altra app, o un servidor intermediari invers davant del servei equivocat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse hat mit etwas geantwortet, das Aura nicht lesen kann. Es könnte eine andere App sein oder ein Reverse-Proxy vor dem falschen Dienst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección respondió con algo que Aura no puede leer. Puede ser otra app, o un proxy inverso delante del servicio equivocado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse a répondu avec quelque chose qu'Aura ne sait pas lire. Il peut s'agir d'une autre app, ou d'un reverse proxy placé devant le mauvais service."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indirizzo ha risposto con qualcosa che Aura non riesce a leggere. Potrebbe essere un'altra app, o un reverse proxy davanti al servizio sbagliato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres antwoordde met iets wat Aura niet kan lezen. Het kan een andere app zijn, of een reverse proxy voor de verkeerde dienst."
          }
        }
      }
    },
    "The address is right and the server replied, but it rejected that username and password.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adreça és correcta i el servidor ha respost, però ha rebutjat aquest nom d'usuari i contrasenya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse stimmt und der Server hat geantwortet, aber Benutzername und Passwort abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección es correcta y el servidor respondió, pero rechazó ese nombre de usuario y contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse est bonne et le serveur a répondu, mais il a refusé ce nom d'utilisateur et ce mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indirizzo è corretto e il server ha risposto, ma ha rifiutato nome utente e password."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres klopt en de server antwoordde, maar weigerde die gebruikersnaam en dat wachtwoord."
          }
        }
      }
    },
