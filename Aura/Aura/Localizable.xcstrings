          "stringUnit": {
            "state": "translated",
            "value": "Otomatik Eşzamanla"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτόματος συγχρονισμός"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซิงค์อัตโนมัติ"
          }
        }
      }
    },
    "The song couldn’t be read from your server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le morceau n’a pas pu être lu depuis votre serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere il brano dal tuo server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la canción desde tu servidor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Song konnte nicht von deinem Server gelesen werden."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut llegir la cançó des del teu servidor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het nummer kon niet van je server worden gelezen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从你的服务器读取这首歌。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать песню с вашего сервера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låten gick inte att läsa från din server."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a música a partir do teu servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a música no seu servidor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać utworu z Twojego serwera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバから曲を読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 곡을 읽을 수 없었어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從你的伺服器讀取這首歌曲。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladbu se nepodařilo přečíst z vašeho serveru."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lese sangen fra serveren din."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangen kunne ikke læses fra din server."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaletta ei voitu lukea palvelimeltasi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Melodia nu a putut fi citită de pe server."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати пісню з вашого сервера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkı sunucundan okunamadı."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση του τραγουδιού από τον διακομιστή σου."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเพลงจากเซิร์ฟเวอร์ของคุณไม่ได้"
          }
        }
      }
    },
    "Too little of the singing could be made out to place the lines. Time them by hand instead.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop peu de chant a pu être compris pour placer les lignes. Calez-les plutôt à la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è capito troppo poco del canto per sistemare le righe. Sincronizzale a mano."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se entendió demasiado poco del canto para colocar las líneas. Sincronízalas a mano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig vom Gesang war zu verstehen, um die Zeilen zu setzen. Synchronisiere sie stattdessen von Hand."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ha entès massa poc del cant per col·locar les línies. Cala-les a mà."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er was te weinig van de zang te verstaan om de regels te plaatsen. Synchroniseer ze met de hand."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能听清的演唱太少，无法放置歌词行。请改为手动对齐。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалось разобрать слишком мало пения, чтобы расставить строки. Расставьте их вручную."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För lite av sången gick att urskilja för att placera raderna. Tajma dem för hand i stället."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi percetível pouco do canto para colocar as linhas. Sincroniza-as manualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi possível distinguir pouco do canto para posicionar os versos. Ajuste o tempo manualmente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt mało śpiewu dało się rozpoznać, by umieścić wersy. Zsynchronizuj je ręcznie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌声が十分に聴き取れず、行を配置できませんでした。代わりに手動でタイミングを合わせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래를 충분히 알아듣지 못해 가사 위치를 맞출 수 없었어요. 대신 직접 타이밍을 맞추세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能辨識出的演唱內容太少，無法放置歌詞行。請改為手動調整時間。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze zpěvu se dalo rozeznat příliš málo na umístění řádků. Načasujte je raději ručně."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For lite av sangen kunne oppfattes til å plassere linjene. Tidsfest dem manuelt i stedet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For lidt af sangen kunne opfattes til at placere linjerne. Tim dem manuelt i stedet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laulusta erottui liian vähän rivien sijoittamiseen. Ajoita ne sen sijaan käsin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "S-a deslușit prea puțin din cântec pentru a plasa rândurile. Sincronizează-le manual."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замало співу вдалося розібрати, щоб розставити рядки. Розставте їх вручну."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırları yerleştirmek için şarkının çok azı anlaşılabildi. Bunun yerine elle zamanla."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τραγούδι ακούστηκε πολύ λίγο καθαρά για να τοποθετηθούν οι στίχοι. Συγχρόνισέ τους χειροκίνητα."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับเสียงร้องได้น้อยเกินไปจนวางบรรทัดไม่ได้ ให้ตั้งเวลาเองแทน"
          }
        }
      }
    },
