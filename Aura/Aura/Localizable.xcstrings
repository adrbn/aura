    "Download music on your iPhone to play it here without a connection": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa música a l'iPhone per escoltar-la aquí sense connexió"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Musik auf dein iPhone, um sie hier ohne Verbindung zu hören"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga música en tu iPhone para escucharla aquí sin conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez de la musique sur votre iPhone pour l'écouter ici sans connexion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica musica sull'iPhone per ascoltarla qui senza connessione"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download muziek op je iPhone om die hier zonder verbinding te luisteren"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上下载音乐，即可在这里离线播放"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите музыку на iPhone, чтобы слушать ее здесь без подключения"
          }
        }
      }
    },
    "No connection — your downloads are in Downloaded": {
      "localizations": {
