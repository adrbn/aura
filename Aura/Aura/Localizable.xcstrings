    "Mixes are built from what you listen to. Play a few things first.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els mixos es creen a partir del que escoltes. Primer escolta alguna cosa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixe entstehen aus dem, was du hörst. Hör zuerst ein paar Titel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mixes se crean a partir de lo que escuchas. Escucha algo primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mix sont composés à partir de vos écoutes. Écoutez d'abord quelques titres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I mix nascono da ciò che ascolti. Prima ascolta qualcosa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixen ontstaan uit wat je luistert. Speel eerst een paar nummers af."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "混音根据你的聆听记录生成。先播放一些歌曲吧。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Миксы создаются на основе того, что вы слушаете. Сначала послушайте что-нибудь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixar skapas av det du lyssnar på. Spela några saker först."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As misturas são criadas a partir do que ouves. Ouve primeiro algumas coisas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os mixes são feitos com o que você ouve. Toque algumas coisas primeiro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksy powstają na podstawie tego, czego słuchasz. Najpierw odtwórz kilka rzeczy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミックスは聴いている音楽から作成されます。まずいくつか再生してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "믹스는 듣는 음악을 바탕으로 만들어져요. 먼저 몇 곡을 재생해 보세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "混音是依據你聆聽的內容製作。請先播放一些歌曲。"
          }
        }
      }
    },
