    "Saved on your server as “%@”. A folder shows once two playlists share it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrée sur votre serveur sous « %@ ». Un dossier apparaît dès que deux playlists le partagent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvata sul server come “%@”. Una cartella appare quando due playlist la condividono."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en tu servidor como “%@”. Una carpeta aparece cuando dos playlists la comparten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Server als „%@“ gespeichert. Ein Ordner erscheint, sobald zwei Playlists ihn teilen."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es desa al servidor com a “%@”. Una carpeta apareix quan dues llistes la comparteixen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen op je server als “%@”. Een map verschijnt zodra twee afspeellijsten hem delen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在服务器上保存为“%@”。两个播放列表共用时才会显示文件夹。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранится на сервере как «%@». Папка появится, когда в ней будут два плейлиста."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparad på din server som ”%@”. En mapp visas när två spellistor delar den."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada no teu servidor como “%@”. Uma pasta só aparece quando duas listas a partilham."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva no seu servidor como “%@”. Uma pasta aparece quando duas playlists a compartilham."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano na Twoim serwerze jako „%@”. Folder pojawia się, gdy dwie playlisty mają ten sam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバに「%@」として保存しました。2つのプレイリストが共有すると、フォルダが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 “%@”(으)로 저장됐어요. 재생목록 두 개가 공유하면 폴더가 표시돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在你的伺服器上儲存為「%@」。當兩個播放列表共用同一個資料夾時，才會顯示該資料夾。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo na vašem serveru jako „%@“. Složka se zobrazí, jakmile ji sdílejí dva playlisty."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret på serveren din som «%@». En mappe vises når to spillelister deler den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt på din server som “%@”. En mappe vises, når to spillelister deler den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu palvelimellesi nimellä ”%@”. Kansio näkyy, kun kaksi soittolistaa jakaa sen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvat pe server ca „%@”. Un dosar apare când două playlisturi îl au în comun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено на сервері як «%@». Папка з’явиться, коли в ній буде два плейлисти."
          }
        },
        "tr": {
          "stringUnit": {
