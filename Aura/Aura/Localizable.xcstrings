        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Músicas destes gêneros nunca tocam em um mix."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory z tych gatunków nigdy nie grają w miksie."
