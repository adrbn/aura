    "Your timing for this song is deleted and the lyrics are looked up again.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva sincronització d'aquesta cançó se suprimeix i la lletra es torna a cercar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Timing für diesen Titel wird gelöscht und der Songtext erneut gesucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina tu sincronización de esta canción y se vuelve a buscar la letra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre calage de ce titre est supprimé et les paroles sont recherchées à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua sincronizzazione di questo brano viene eliminata e il testo viene cercato di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je synchronisatie voor dit nummer wordt verwijderd en de songtekst wordt opnieuw opgezocht."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除你为这首歌调整的时间轴，并重新查找歌词。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша синхронизация для этой песни будет удалена, а текст будет найден заново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din timing för den här låten raderas och låttexten slås upp igen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização desta música é apagada e a letra é procurada de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo desta música é apagado e a letra é buscada de novo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja synchronizacja dla tego utworu zostanie usunięta, a tekst zostanie wyszukany ponownie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この曲のタイミングを削除し、歌詞をもう一度検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 곡의 타이밍이 삭제되고 가사를 다시 찾아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這首歌曲你設定的時間軸會被刪除，並重新查詢歌詞。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše časování této skladby se smaže a text se vyhledá znovu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Timingen din for denne sangen slettes, og sangteksten slås opp på nytt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din timing for denne sang slettes, og sangteksten slås op igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kappaleen ajoituksesi poistetaan ja sanat haetaan uudelleen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizarea ta pentru această melodie este ștearsă și versurile sunt căutate din nou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашу синхронізацію для цієї пісні буде видалено, а текст знайдено заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şarkı için zamanlaman silinir ve sözler yeniden aranır."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο συγχρονισμός σου για αυτό το τραγούδι διαγράφεται και οι στίχοι αναζητούνται ξανά."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
