    "Their new releases come back to the radar at its next daily pass.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les seves novetats tornen al radar en el pròxim pas diari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Neuerscheinungen erscheinen beim nächsten täglichen Durchlauf wieder im Radar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus novedades volverán al radar en su próximo paso diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses nouveautés reviennent sur le radar à son prochain passage quotidien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le loro nuove uscite tornano sul radar al prossimo passaggio giornaliero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hun nieuwe releases verschijnen weer op de radar bij de volgende dagelijkse ronde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其新发行会在雷达下次每日更新时回来。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их новинки вернутся на радар при следующем ежедневном обновлении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Deras nya utgåvor kommer tillbaka till radarn vid nästa dagliga genomgång."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os novos lançamentos deles voltam ao radar na próxima passagem diária."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os novos lançamentos deles voltam ao radar na próxima passagem diária."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich nowe wydania wrócą do radaru przy następnym codziennym przebiegu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
