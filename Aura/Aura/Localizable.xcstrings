          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultados offline — só músicas baixadas e em cache"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyniki offline — tylko pobrane i zapisane w pamięci podręcznej utwory"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインの結果 — ダウンロード済みとキャッシュ済みの曲のみ"
