    "Lossless files will be transcoded to MP3 at %lld kbps. Incompatible formats (OGG/Opus) are auto-transcoded.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els fitxers sense pèrdua es transcodificaran a MP3 a %lld kbps. Els formats incompatibles (OGG/Opus) es transcodifiquen automàticament."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlustfreie Dateien werden mit %lld kbps in MP3 umgewandelt. Inkompatible Formate (OGG/Opus) werden automatisch umgewandelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos sin pérdida se transcodificarán a MP3 a %lld kbps. Los formatos incompatibles (OGG/Opus) se transcodifican automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sans perte seront transcodés en MP3 à %lld kbps. Les formats incompatibles (OGG/Opus) sont transcodés automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file senza perdita verranno transcodificati in MP3 a %lld kbps. I formati incompatibili (OGG/Opus) vengono transcodificati automaticamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lossless-bestanden worden getranscodeerd naar MP3 op %lld kbps. Incompatibele formaten (OGG/Opus) worden automatisch getranscodeerd."
          }
        }
      }
    },
