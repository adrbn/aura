    "Tap another server to switch to it. Swipe left to remove.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un altre servidor per canviar-hi. Llisca cap a l'esquerra per retirar-lo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen anderen Server, um zu ihm zu wechseln. Wische nach links, um ihn zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca otro servidor para cambiar a él. Desliza a la izquierda para quitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher un autre serveur pour y basculer. Balayer vers la gauche pour le retirer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un altro server per passare a esso. Scorri verso sinistra per rimuoverlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een andere server om ernaartoe te wisselen. Swipe naar links om te verwijderen."
          }
        }
      }
    },
