    "Only the lyrics you translate go to Google, with the song's title and artist.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només la lletra que tradueixes arriba a Google, juntament amb el títol i l'artista de la cançó."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der übersetzte Songtext wird an Google gesendet, zusammen mit Titel und Interpret des Songs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se envía a Google la letra que traduces, junto con el título y el artista de la canción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les paroles traduites partent chez Google, avec le titre et l’artiste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo il testo che traduci viene inviato a Google, insieme al titolo e all'artista del brano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de songtekst die je vertaalt wordt naar Google gestuurd, samen met de titel en artiest van het nummer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你翻译的歌词会发送给 Google，并附带歌曲名称和艺人。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Google отправляется только переводимый текст вместе с названием песни и артистом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara de låttexter du översätter skickas till Google, tillsammans med låtens titel och artist."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a letra que traduzires é enviada à Google, com o título e o artista da música."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a letra que você traduz vai para o Google, com o título e o artista da música."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do Google trafiają tylko teksty, które tłumaczysz, wraz z tytułem i wykonawcą utworu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleに送信されるのは、翻訳する歌詞と、曲のタイトルおよびアーティスト名のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역하는 가사만 곡 제목 및 아티스트와 함께 Google로 전송돼요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你翻譯的歌詞會傳送給 Google，並附上歌曲的標題和演出者。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do Google se odesílají jen texty, které překládáte, spolu s názvem skladby a interpretem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare sangtekstene du oversetter, sendes til Google, sammen med sangens tittel og artist."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun de sangtekster, du oversætter, sendes til Google sammen med sangens titel og kunstner."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain kääntämäsi sanat lähetetään Googlelle, kappaleen nimen ja artistin kanssa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar versurile pe care le traduci ajung la Google, cu titlul și artistul melodiei."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До Google надходять лише тексти, які ви перекладаєте, разом із назвою пісні й виконавцем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google'a yalnızca çevirdiğin sözler, şarkının adı ve sanatçısıyla gider."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο οι στίχοι που μεταφράζεις πηγαίνουν στη Google, με τον τίτλο και τον καλλιτέχνη του τραγουδιού."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงเนื้อเพลงที่คุณแปลเท่านั้นที่ส่งไปยัง Google พร้อมชื่อเพลงและศิลปิน"
          }
        }
      }
    },
