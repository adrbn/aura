    "Offline results — downloaded and cached songs only": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultats sense connexió — només cançons baixades i en memòria cau"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Ergebnisse — nur heruntergeladene und zwischengespeicherte Titel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultados sin conexión — solo canciones descargadas y en caché"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résultats hors ligne — titres téléchargés et en cache uniquement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risultati offline — solo brani scaricati e in cache"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline resultaten — alleen gedownloade en gecachete nummers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线结果 — 仅限已下载和已缓存的歌曲"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн-результаты — только загруженные и кэшированные песни"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Offlineresultat – bara nedladdade och cachade låtar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
