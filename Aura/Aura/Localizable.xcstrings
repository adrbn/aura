    "File Browser didn't accept the sign-in as “%@”. Type File Browser's own username and password in Settings, under Save Synced Lyrics to the Server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser a refusé la connexion en tant que « %@ ». Saisissez le nom d’utilisateur et le mot de passe de File Browser dans Réglages, sous Enregistrer les paroles synchronisées sur le serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser hat die Anmeldung als „%@“ abgelehnt. Gib den Benutzernamen und das Passwort von File Browser in den Einstellungen unter „Synchronisierte Songtexte auf dem Server sichern“ ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser no aceptó el inicio de sesión como «%@». Escribe el usuario y la contraseña de File Browser en Ajustes, en Guardar letras sincronizadas en el servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser non ha accettato l’accesso come «%@». Inserisci nome utente e password di File Browser in Impostazioni, sotto Salva i testi sincronizzati sul server."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser no ha acceptat l’inici de sessió com a «%@». Escriu l’usuari i la contrasenya de File Browser a Configuració, a Desa les lletres sincronitzades al servidor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser weigerde de aanmelding als ‘%@’. Vul de gebruikersnaam en het wachtwoord van File Browser in bij Instellingen, onder Gesynchroniseerde songteksten op de server bewaren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser 未接受以“%@”登录。请在“设置”的“将同步歌词存储到服务器”下输入 File Browser 自己的用户名和密码。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser не принял вход как «%@». Введите имя пользователя и пароль File Browser в Настройках, в разделе «Сохранять синхронизированные тексты на сервере»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser godtog inte inloggningen som ”%@”. Skriv File Browsers eget användarnamn och lösenord i Inställningar, under Spara synkad låttext på servern."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O File Browser não aceitou o início de sessão como “%@”. Introduz o nome de utilizador e a palavra-passe do próprio File Browser nas Definições, em Guardar letras sincronizadas no servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O File Browser não aceitou o login como “%@”. Digite o usuário e a senha do próprio File Browser nos Ajustes, em Salvar letras sincronizadas no servidor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser nie zaakceptował logowania jako „%@”. Wpisz własną nazwę użytkownika i hasło File Browser w Ustawieniach, w sekcji Zapisz zsynchronizowane teksty na serwerze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browserは「%@」でのサインインを受け付けませんでした。設定の「同期歌詞をサーバに保存」で、File Browser自身のユーザ名とパスワードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser에서 “%@”(으)로 로그인을 받아들이지 않았어요. 설정의 서버에 동기화 가사 저장에서 File Browser 자체의 사용자 이름과 암호를 입력하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser 未接受以「%@」登入。請在「設定」的「將同步歌詞儲存到伺服器」下輸入 File Browser 自己的使用者名稱和密碼。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser nepřijal přihlášení jako „%@“. Zadejte v Nastavení vlastní uživatelské jméno a heslo File Browser, v části Uložit synchronizované texty na server."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser godtok ikke påloggingen som «%@». Skriv inn File Browsers eget brukernavn og passord i Innstillinger, under Lagre synkroniserte sangtekster på serveren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser accepterede ikke login som “%@”. Angiv File Browsers eget brugernavn og adgangskode i Indstillinger under Gem synkroniseret sangtekst på serveren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser ei hyväksynyt kirjautumista käyttäjänä ”%@”. Kirjoita File Browserin oma käyttäjänimi ja salasana Asetuksiin kohtaan Tallenna ajastetut sanat palvelimelle."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser nu a acceptat autentificarea ca „%@”. Introdu numele de utilizator și parola proprii File Browser în Configurări, la Salvează versurile sincronizate pe server."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser не прийняв вхід як «%@». Введіть власне ім’я користувача й пароль File Browser у Параметрах, у розділі «Зберегти синхронні тексти на сервері»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser “%@” olarak girişi kabul etmedi. Ayarlar'da, Eşzamanlı Sözleri Sunucuya Kaydet altında File Browser'ın kendi kullanıcı adını ve parolasını yaz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το File Browser δεν δέχτηκε τη σύνδεση ως «%@». Πληκτρολόγησε το όνομα χρήστη και τον κωδικό του File Browser στις Ρυθμίσεις, στην Αποθήκευση συγχρονισμένων στίχων στον διακομιστή."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "File Browser ไม่ยอมรับการลงชื่อเข้าเป็น “%@” ป้อนชื่อผู้ใช้และรหัสผ่านของ File Browser เองในการตั้งค่า ใต้บันทึกเนื้อเพลงซิงค์ไปยังเซิร์ฟเวอร์"
          }
        }
      }
    },
