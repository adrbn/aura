    "Cycles repeat in Aura: off, all, then one.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvia el mode de repetició de l'Aura: desactivada, tot, i després una cançó."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Wiederholung in Aura durch: aus, alle, dann einen Titel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el modo de repetición en Aura: desactivada, todo, luego una canción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait tourner la répétition dans Aura : désactivée, tout, puis un titre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa scorrere la ripetizione in Aura: disattivata, tutti, poi un brano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorloopt herhalen in Aura: uit, alles, dan één."
          }
        }
      }
    },
