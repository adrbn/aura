    "ReplayGain turns loud tracks down to a common level, using the tags on your server. Quiet tracks are not boosted.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain redueix les cançons massa fortes a un nivell comú, segons les etiquetes del servidor. Les cançons fluixes no s'amplifiquen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain senkt laute Titel anhand der Tags deines Servers auf ein gemeinsames Niveau. Leise Titel werden nicht verstärkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain baja las canciones demasiado altas a un nivel común, usando las etiquetas de tu servidor. Las canciones bajas no se amplifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain baisse les titres trop forts à un niveau commun, d’après les tags du serveur. Les titres faibles ne sont pas amplifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain abbassa i brani troppo alti a un livello comune, usando i tag del tuo server. I brani deboli non vengono amplificati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain zet te harde nummers terug naar een gemeenschappelijk niveau, op basis van de tags op je server. Zachte nummers worden niet versterkt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain 会根据服务器上的标签，将响度高的曲目调低到统一水平。安静的曲目不会被增强。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain приглушает громкие треки до общего уровня по тегам на сервере. Тихие треки не усиливаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain sänker höga spår till en gemensam nivå med hjälp av taggarna på din server. Tysta spår höjs inte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ReplayGain baixa as faixas mais altas para um nível comum, usando as etiquetas do teu servidor. As faixas mais baixas não são amplificadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ReplayGain reduz as faixas altas a um nível comum, usando as tags do seu servidor. Faixas baixas não são amplificadas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain ścisza głośne utwory do wspólnego poziomu, korzystając z tagów na Twoim serwerze. Ciche utwory nie są podgłaśniane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGainは、サーバ上のタグを使って音量の大きいトラックを共通のレベルまで下げます。音量の小さいトラックは持ち上げません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain은 서버의 태그를 사용해 큰 트랙의 소리를 공통 수준으로 낮춰요. 조용한 트랙은 키우지 않아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayGain 會依據伺服器上的標籤，將音量較大的歌曲降到一致的音量。音量較小的歌曲不會被調大。"
          }
        }
      }
    },
