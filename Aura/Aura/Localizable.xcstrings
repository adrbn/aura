    "Your downloads are not touched, and anything cleared is fetched again next time you play it.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves baixades no es toquen, i el que es buidi es tornarà a obtenir la propera vegada que ho reprodueixis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Downloads bleiben unberührt, und alles Geleerte wird beim nächsten Abspielen erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus descargas no se tocan, y lo que se vacíe se volverá a obtener la próxima vez que lo reproduzcas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos téléchargements ne sont pas touchés, et tout ce qui est vidé sera récupéré à nouveau à la prochaine lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi download non vengono toccati, e ciò che viene svuotato sarà recuperato di nuovo alla prossima riproduzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je downloads blijven onaangeroerd, en wat gewist wordt, wordt opnieuw opgehaald zodra je het weer afspeelt."
          }
        }
      }
    },
    "Your library. Your server.\nNothing in between.": {
