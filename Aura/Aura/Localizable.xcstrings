        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом iPhone ничего не найдено по запросу «%@»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget på den här iPhonen matchar ”%@”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada neste iPhone corresponde a “%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada neste iPhone corresponde a “%@”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic na tym iPhonie nie pasuje do „%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneに「%@」に一致する項目はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 “%@”와(과) 일치하는 항목이 없어요."
