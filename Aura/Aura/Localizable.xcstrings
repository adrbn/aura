        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke mixen Home maakt, uit welke genres en hoeveel nummers per mix."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首页生成哪些混音、来自哪些流派，以及每个混音的歌曲数。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какие миксы создаёт главная, из каких жанров и сколько песен в каждом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilka mixar Hem skapar, från vilka genrer och hur många låtar var och en har."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Que misturas o Início cria, de que géneros e quantas músicas cada uma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quais mixes o Início cria, de quais gêneros e quantas músicas cada um."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
