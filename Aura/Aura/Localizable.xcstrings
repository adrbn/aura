    "Tap another server to switch to it. Swipe left to remove.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un altre servidor per canviar-hi. Llisca cap a l'esquerra per retirar-lo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen anderen Server, um zu ihm zu wechseln. Wische nach links, um ihn zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca otro servidor para cambiar a él. Desliza a la izquierda para quitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher un autre serveur pour y basculer. Balayer vers la gauche pour le retirer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un altro server per passare a esso. Scorri verso sinistra per rimuoverlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een andere server om ernaartoe te wisselen. Swipe naar links om te verwijderen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点另一台服务器即可切换。向左轻扫可移除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь другого сервера, чтобы переключиться на него. Смахните влево, чтобы удалить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en annan server för att byta till den. Svep åt vänster för att ta bort."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca noutro servidor para mudar para ele. Desliza para a esquerda para remover."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em outro servidor para alternar para ele. Deslize para a esquerda para remover."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij inny serwer, aby się na niego przełączyć. Przesuń w lewo, aby usunąć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のサーバをタップして切り替えます。左にスワイプすると削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 서버를 탭하면 전환돼요. 왼쪽으로 밀면 제거할 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下其他伺服器即可切換。向左滑動即可移除。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na jiný server se na něj přepneš. Přejetím doleva ho odebereš."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en annen server for å bytte til den. Sveip til venstre for å fjerne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en anden server for at skifte til den. Skub til venstre for at fjerne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda toiseen palvelimeen napauttamalla sitä. Poista pyyhkäisemällä vasemmalle."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge alt server pentru a comuta la el. Glisează la stânga pentru a-l elimina."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться іншого сервера, щоб перемкнутися на нього. Проведіть уліво, щоб вилучити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmek için başka bir sunucuya dokun. Kaldırmak için sola kaydır."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε άλλον διακομιστή για να αλλάξεις σε αυτόν. Σάρωσε αριστερά για αφαίρεση."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเซิร์ฟเวอร์อื่นเพื่อสลับไป ปัดไปทางซ้ายเพื่อเอาออก"
          }
        }
      }
    },
