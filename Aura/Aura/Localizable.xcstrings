    "Nothing answered at %@. Check the address and the port, and that you're on the right network or VPN.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Res no ha respost a %@. Comprova l'adreça i el port, i que ets a la xarxa o VPN correcta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter %@ hat nichts geantwortet. Prüfe Adresse und Port und ob du im richtigen Netzwerk oder VPN bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada respondió en %@. Revisa la dirección y el puerto, y que estás en la red o VPN correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a répondu à %@. Vérifiez l'adresse et le port, et que vous êtes sur le bon réseau ou VPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna risposta da %@. Controlla l'indirizzo e la porta, e di essere sulla rete o VPN giusta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets reageerde op %@. Controleer het adres en de poort, en of je op het juiste netwerk of VPN zit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有响应。请检查地址和端口，并确认你连接的是正确的网络或 VPN。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По адресу %@ ничего не ответило. Проверьте адрес и порт, а также что вы в нужной сети или VPN."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget svarade på %@. Kontrollera adressen och porten, och att du är på rätt nätverk eller VPN."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada respondeu em %@. Verifica o endereço e a porta, e se estás na rede ou VPN certa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada respondeu em %@. Confira o endereço e a porta, e se você está na rede ou VPN certa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie odpowiedziało pod adresem %@. Sprawdź adres i port oraz czy jesteś w odpowiedniej sieci lub VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から応答がありません。アドレスとポート、および正しいネットワークまたはVPNに接続しているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 응답이 없어요. 주소와 포트, 그리고 올바른 네트워크나 VPN에 연결되어 있는지 확인하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有回應。請檢查位址和連接埠，以及你是否位於正確的網路或 VPN。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na %@ nikdo neodpověděl. Zkontrolujte adresu a port a zda jste ve správné síti nebo VPN."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting svarte på %@. Sjekk adressen og porten, og at du er på riktig nettverk eller VPN."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet svarede på %@. Tjek adressen og porten, og at du er på det rigtige netværk eller VPN."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoitteesta %@ ei vastattu. Tarkista osoite ja portti sekä se, että olet oikeassa verkossa tai VPN:ssä."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu a răspuns la %@. Verifică adresa și portul și dacă ești în rețeaua sau VPN-ul corect."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо не відповіло на %@. Перевірте адресу й порт, а також що ви в потрібній мережі чи VPN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adresinde yanıt veren olmadı. Adresi ve kapıyı, doğru ağda veya VPN'de olduğunu kontrol et."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία απάντηση στο %@. Έλεγξε τη διεύθυνση και τη θύρα, και ότι είσαι στο σωστό δίκτυο ή VPN."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการตอบสนองที่ %@ ตรวจสอบที่อยู่และพอร์ต และตรวจสอบว่าคุณอยู่บนเครือข่ายหรือ VPN ที่ถูกต้อง"
          }
        }
      }
    },
