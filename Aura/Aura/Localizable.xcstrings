    "Quick scan checks for new/changed files. Full scan re-reads all metadata.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'escaneig ràpid busca fitxers nous o modificats. L'escaneig complet torna a llegir totes les metadades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schnellscan prüft auf neue oder geänderte Dateien. Der vollständige Scan liest alle Metadaten neu ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis rápido busca archivos nuevos o modificados. El análisis completo vuelve a leer todos los metadatos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse rapide recherche les fichiers nouveaux ou modifiés. L'analyse complète relit toutes les métadonnées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione rapida cerca file nuovi o modificati. La scansione completa rilegge tutti i metadati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De snelle scan controleert op nieuwe of gewijzigde bestanden. De volledige scan leest alle metadata opnieuw in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速扫描会检查新增或更改的文件。完整扫描会重新读取所有元数据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрое сканирование ищет новые и измененные файлы. Полное сканирование заново считывает все метаданные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabbgenomsökning letar efter nya eller ändrade filer. Full genomsökning läser om all metadata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise rápida verifica ficheiros novos ou alterados. A análise completa volta a ler todos os metadados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação rápida procura arquivos novos ou alterados. A verificação completa relê todos os metadados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybkie skanowanie sprawdza nowe lub zmienione pliki. Pełne skanowanie ponownie wczytuje wszystkie metadane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイックスキャンは新規または変更されたファイルを確認します。フルスキャンはすべてのメタデータを再読み込みします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 스캔은 새 파일이나 변경된 파일을 확인해요. 전체 스캔은 모든 메타데이터를 다시 읽어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速掃描會檢查新增或變更的檔案。完整掃描會重新讀取所有中繼資料。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlé skenování zkontroluje nové nebo změněné soubory. Úplné skenování znovu načte všechna metadata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rask skanning ser etter nye/endrede filer. Full skanning leser alle metadata på nytt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtig scanning tjekker for nye/ændrede filer. Fuld scanning genindlæser alle metadata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikaskannaus etsii uudet ja muuttuneet tiedostot. Täysi skannaus lukee kaikki metatiedot uudelleen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanarea rapidă caută fișiere noi/modificate. Scanarea completă recitește toate metadatele."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидке сканування шукає нові чи змінені файли. Повне — перечитує всі метадані."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı tarama yeni/değişen dosyaları denetler. Tam tarama tüm meta verileri yeniden okur."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γρήγορη σάρωση ελέγχει για νέα/αλλαγμένα αρχεία. Η πλήρης σάρωση ξαναδιαβάζει όλα τα μεταδεδομένα."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนด่วนตรวจหาไฟล์ใหม่/ที่เปลี่ยนแปลง สแกนเต็มจะอ่านข้อมูลเมตาทั้งหมดใหม่"
          }
        }
      }
    },
